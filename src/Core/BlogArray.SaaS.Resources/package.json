{
  "name": "blogarray.saas.resources",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "author": "BlogArray,sisindrymedagam",
  "license": "MIT",
  "scripts": {
    "build:css": "sass wwwroot/css/site.scss wwwroot/css/site.css && postcss wwwroot/css/site.css --replace && postcss wwwroot/css/site.css --env production -o wwwroot/css/site.min.css",
    "build:js": "uglifyjs wwwroot/js/site.js -c -m -o wwwroot/js/site.min.js",
    "watch:css": "nodemon -e scss -x \"npm run build:css\"",
    "watch:js": "nodemon -e js -x \"npm run build:js\"",
    "watch": "npm run watch:css & npm run watch:js",
    "build": "npm run build:lib && npm run build:css && npm run build:js",
    "build:lib": "node -e \"require('fs').cpSync('node_modules/bootstrap/dist/js','wwwroot/lib/bootstrap/dist/js',{recursive:true})\""
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "bootstrap": "6.0.0-alpha.1",
    "cssnano": "^7.0.6",
    "nodemon": "^3.1.7",
    "postcss-cli": "^12.0.0",
    "postcss-prefix-custom-properties": "^0.1.0",
    "sass": "^1.106.1",
    "uglify-js": "^3.19.3"
  }
}
