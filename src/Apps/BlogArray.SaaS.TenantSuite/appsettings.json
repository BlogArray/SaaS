{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Identity": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OIDC": {
    "ClientId": "tenantconsole",
    "ClientSecret": "615dc2576a304db88cb881f235682cd4",
    "Issuer": "https://id.blogarray.dev/",
    "Authority": "https://id.blogarray.dev/"
  },
  "IPSafeList": "127.0.0.1;192.168.1.5;::1",
  "ConnectionStrings": {
    "IdentityContext": "Data Source=.;Initial Catalog=BlogArray.SaaS.Identity;User Id=sa; Password=welcome;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "multi-tenant"
  },
  "Cache": {
    "Type": "SqlServer", //SqlServer or Redis
    "ConnectionString": "Data Source=.;Initial Catalog=DistCache;User Id=sa; Password=welcome;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "SlidingExpirationInMinutes": 30,
    "AbsoluteExpirationInHours": 6
  },
  "Links": {
    "Suite": "https://console.blogarray.dev/",
    "Identity": "https://id.blogarray.dev/",
    "Admin": "https://admin.blogarray.dev/",
    "Issuer": "https://id.blogarray.dev/",
    "Authority": "https://id.blogarray.dev/"
  },
  "SMTP": {
    "FromEmail": "noreply@app.com",
    "FromName": "App Development",
    "Username": "localhost",
    "Password": "ttczmtxemkinbzxv",
    "Host": "localhost",
    "Port": 587,
    "EnableSsl": false
  },
  "Defaults": {
    "DefaultLogoUrl": "https://id.blogarray.dev/_content/BlogArray.SaaS.Resources/resources/images/blogarray-full-logo.png",
    "DefaultFaviconUrl": "https://id.blogarray.dev/_content/BlogArray.SaaS.Resources/resources/images/blogarray-icon.png"
  },
  "ApiKey": {
    //Number of leading characters of a tenant API key kept for display in the admin UI;
    //the key itself is stored only as a hash. Changing this does not affect already-issued keys.
    "PrefixLength": 8
  },
  "DataProtection": {
    //Mode selects where the shared DataProtection key ring lives (Identity, TenantSuite
    //and App share application name BlogArray.SaaS, so all three must use the same store):
    //  Local         - shared folder (self-hosted/IIS), see KeyRingPath.
    //  AzureKeyVault - Azure App Service: persists to BlobUri (SAS URI or managed identity)
    //                  and optionally encrypts the ring with KeyVaultKeyId.
    //Losing the ring (or vault keys) makes protected tenant keys unrecoverable - back it up.
    "Mode": "Local",
    "BlobUri": "",
    "KeyRingPath": "C:\\ProgramData\\BlogArray\\DataProtection-Keys",
    "KeyVaultKeyId": ""
  },
  "Passwords": {
    "HistorySize": 5, //previous passwords remembered per user; new passwords cannot reuse them
    "BlockBreachedPasswords": true //reject passwords found in known data breaches (HIBP k-anonymity; fails open when unreachable)
  },
  "Cors": {
    //Semicolon-separated origins allowed to call this app's endpoints from a browser
    //cross-origin, e.g. "https://dashboard.blogarray.dev;https://partner.contoso.com".
    //Empty = no cross-origin access (correct for server-rendered apps).
    "AllowedOrigins": ""
  },
  "Tenants": {
    //Semicolon-separated allow-list of SQL Server hosts that tenant connection strings may
    //target (tenant edit "test connection" and personnel enable/disable), e.g.
    //"localhost;tenant-sql-1.database.windows.net". Empty = any host (development only -
    //always set in production to prevent internal-network probing).
    "AllowedSqlHosts": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm zzz } [{Level}] {Message}{NewLine}{FullException} {Exception}"
        }
      }
    ]
  }
}
