@using System.Security.Claims

@{
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}

<div class="app-layout">
    <nav class="navbar navbar-expand-lg fixed-top bg-body bg-dark app-navbar border-bottom" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler border-0" type="button" aria-label="Toggle navigation"
                    onclick="toggleMobileMenu()">
                <i class="bi bi-list"></i>
            </button>
            <div class="text-start d-flex align-items-center">
                <button class="btn btn-outline-secondary border-0 text-white d-none d-md-inline-flex align-items-center me-1"
                        type="button" aria-label="Toggle sidebar" onclick="toggleSidenav()">
                    <i class="bi bi-layout-sidebar" id="sidenavToggleIcon"></i>
                </button>
                <a class="navbar-brand" style="font-size:1.5rem" asp-controller="Dashboard" asp-action="Index">
                    <img src="~/_content/BlogArray.SaaS.Resources/resources/images/blogarray-tenant-full-icon.png" alt="Logo" height="30"
                         class="d-inline-block align-text-top">
                    <span class="mx-1 d-none d-md-inline fw-normal">Suite</span>
                </a>
            </div>
            <div class="text-end d-flex align-items-center">
                @if (User.Identity.IsAuthenticated)
                {
                    <partial name="_LoginPartial" />
                }
            </div>
        </div>
    </nav>
    <main class="app-main" id="app-main">
        <aside class="d-flex flex-column flex-shrink-0 p-3 bg-body app-sidenav border-end z-3" data-bs-theme="dark">
            <ul class="nav nav-pills flex-column mb-auto hoverable-bg">
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="Index" asp-controller="Dashboard" title="Dashboard" class="nav-link text-body-emphasis">
                        <i class="bi bi-speedometer2 me-2"></i>
                        <span class="sidenav-label">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="Index" asp-controller="Tenants" title="Tenants" class="nav-link text-body-emphasis">
                        <i class="bi bi-buildings me-2"></i>
                        <span class="sidenav-label">Tenants</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="Index" asp-controller="Users" title="Users" class="nav-link text-body-emphasis">
                        <i class="bi bi-people me-2"></i>
                        <span class="sidenav-label">Users</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="SignInLogs" asp-controller="SecurityLogs" title="Sign-in logs" class="nav-link text-body-emphasis">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        <span class="sidenav-label">Sign-in logs</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="AuditLogs" asp-controller="SecurityLogs" title="Audit logs" class="nav-link text-body-emphasis">
                        <i class="bi bi-journal-text me-2"></i>
                        <span class="sidenav-label">Audit logs</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="Index" asp-controller="Roles" title="Roles" class="nav-link text-body-emphasis">
                        <i class="bi bi-lock me-2"></i>
                        <span class="sidenav-label">Roles</span>
                    </a>
                </li>
                <li class="nav-item pt-1">
                    <a active-class="bg-body-secondary" active-route asp-area="" asp-action="Index" asp-controller="Scopes" title="Scopes" class="nav-link text-body-emphasis">
                        <i class="bi bi-key me-2"></i>
                        <span class="sidenav-label">Scopes</span>
                    </a>
                </li>
            </ul>
        </aside>
        <div class="d-flex flex-column app-container">
            <div class="app-body container-fluid mt-2 h-main-app-body">
                <partial name="_AlertPartial" />
                @RenderBody()
            </div>
            <footer class="p-2 mt-5">
                <div class="mx-auto text-center">
                    <p>
                        © @DateTime.Now.Year - <a href="https://blogarray.net/" target="_blank">BlogArray</a>, Crafted by Team BlogArray.
                    </p>
                </div>
            </footer>
        </div>
    </main>
</div>
@await RenderSectionAsync("Scripts", required: false)

<script>
    var sidenavLocalStorageKey = 'sidenav-collapsed';

    function toggleSidenav() {
        var collapsed = document.getElementById('app-main').classList.toggle('sidenav-collapsed');
        localStorage.setItem(sidenavLocalStorageKey, collapsed ? 'true' : 'false');
        updateSidenavToggleIcon(collapsed);
    }

    function updateSidenavToggleIcon(collapsed) {
        var icon = document.getElementById('sidenavToggleIcon');
        if (!icon) return;

        // Expanded: arrow points left (click to collapse). Collapsed: arrow points right
        // (click to expand).
        icon.classList.toggle('bi-arrow-bar-left', !collapsed);
        icon.classList.toggle('bi-arrow-bar-right', collapsed);
    }

    (function() {
        if (localStorage.getItem(sidenavLocalStorageKey) === 'true') {
            document.getElementById('app-main').classList.add('sidenav-collapsed');
            updateSidenavToggleIcon(true);
        }
    })();

    function toggleMobileMenu() {
        $('#app-main').toggleClass('open');
    }
</script>
