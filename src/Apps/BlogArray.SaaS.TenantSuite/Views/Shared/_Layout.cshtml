@using System.Security.Claims

@{
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}

<div class="app-layout">
    <nav class="navbar lg:navbar-expand fixed-top app-navbar">
        <div class="container-fluid">
            <button class="navbar-toggler btn-icon border-0" type="button" aria-label="Toggle navigation"
                    onclick="toggleMobileMenu()">
                <i class="bi bi-list"></i>
            </button>
            <div class="text-start d-flex align-items-center">
                <button class="btn btn-text theme-secondary btn-icon d-none md:d-inline-flex align-items-center me-1"
                        type="button" aria-label="Toggle sidebar" onclick="toggleSidenav()">
                    <i class="bi bi-layout-sidebar" id="sidenavToggleIcon"></i>
                </button>
                <a class="navbar-brand" style="font-size:1.5rem" asp-controller="Dashboard" asp-action="Index">
                    <img src="~/_content/BlogArray.SaaS.Resources/resources/images/blogarray-tenant-full-icon.png" alt="Logo" height="30"
                         class="d-inline-block align-text-top">
                    <span class="mx-1 d-none md:d-inline fw-normal">Suite</span>
                </a>
            </div>
            <div class="ms-auto text-end d-flex align-items-center gap-1">
                <partial name="_ColorModeMenu" />
                @if (User.Identity.IsAuthenticated)
                {
                    <partial name="_LoginPartial" />
                }
            </div>
        </div>
    </nav>
    <main class="app-main" id="app-main">
        <aside class="flex-column flex-shrink-0 p-5 app-sidenav">
            <nav class="app-nav" aria-label="Primary">
                <div class="app-nav-group">
                    <strong class="app-nav-heading" data-color="violet"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>Overview</strong>
                    <ul class="nav flex-column">
                        <li>
                            <a active-route asp-area="" asp-action="Index" asp-controller="Dashboard" class="nav-link" title="Dashboard">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                <span class="sidenav-label">Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="app-nav-group">
                    <strong class="app-nav-heading" data-color="blue"><i class="bi bi-people-fill" aria-hidden="true"></i>Directory</strong>
                    <ul class="nav flex-column">
                        <li>
                            <a active-route asp-area="" asp-action="Index" asp-controller="Tenants" class="nav-link" title="Tenants">
                                <i class="bi bi-buildings" aria-hidden="true"></i>
                                <span class="sidenav-label">Tenants</span>
                            </a>
                        </li>
                        <li>
                            <a active-route asp-area="" asp-action="Index" asp-controller="Users" class="nav-link" title="Users">
                                <i class="bi bi-people" aria-hidden="true"></i>
                                <span class="sidenav-label">Users</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="app-nav-group">
                    <strong class="app-nav-heading" data-color="green"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i>Access</strong>
                    <ul class="nav flex-column">
                        <li>
                            <a active-route asp-area="" asp-action="Index" asp-controller="Roles" class="nav-link" title="Roles">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <span class="sidenav-label">Roles</span>
                            </a>
                        </li>
                        <li>
                            <a active-route asp-area="" asp-action="Index" asp-controller="Scopes" class="nav-link" title="Scopes">
                                <i class="bi bi-key" aria-hidden="true"></i>
                                <span class="sidenav-label">Scopes</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="app-nav-group">
                    <strong class="app-nav-heading" data-color="orange"><i class="bi bi-activity" aria-hidden="true"></i>Activity</strong>
                    <ul class="nav flex-column">
                        <li>
                            <a active-route asp-area="" asp-action="SignInLogs" asp-controller="SecurityLogs" class="nav-link" title="Sign-in logs">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                <span class="sidenav-label">Sign-in logs</span>
                            </a>
                        </li>
                        <li>
                            <a active-route asp-area="" asp-action="AuditLogs" asp-controller="SecurityLogs" class="nav-link" title="Audit logs">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>
                                <span class="sidenav-label">Audit logs</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </aside>
        <div class="d-flex flex-column app-container">
            <div class="app-body container-fluid h-main-app-body">
                <partial name="_AlertPartial" />
                @RenderBody()
            </div>
            <footer class="py-5 px-5 text-center small fg-3">
                © @DateTime.Now.Year <a href="https://blogarray.net/" target="_blank" class="fg-2">BlogArray</a> · Crafted by Team BlogArray
            </footer>
        </div>
    </main>
</div>
@await RenderSectionAsync("Scripts", required: false)

<script>
    var sidenavLocalStorageKey = 'sidenav-collapsed';

    function toggleSidenav() {
        var collapsed = document.getElementById('app-main').classList.toggle('sidenav-collapsed');
        localStorage.setItem(sidenavLocalStorageKey, collapsed ? 'true' : 'false');
        updateSidenavToggleIcon(collapsed);
    }

    function updateSidenavToggleIcon(collapsed) {
        var icon = document.getElementById('sidenavToggleIcon');
        if (!icon) return;

        // Expanded: arrow points left (click to collapse). Collapsed: arrow points right
        // (click to expand).
        icon.classList.toggle('bi-arrow-bar-left', !collapsed);
        icon.classList.toggle('bi-arrow-bar-right', collapsed);
    }

    (function() {
        if (localStorage.getItem(sidenavLocalStorageKey) === 'true') {
            document.getElementById('app-main').classList.add('sidenav-collapsed');
            updateSidenavToggleIcon(true);
        }
    })();

    function toggleMobileMenu() {
        $('#app-main').toggleClass('open');
    }
</script>
