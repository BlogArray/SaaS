@model RoleViewModel

@{
    ViewData["Title"] = "Create a new role";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">Create a new role</h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All roles
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">Create</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="fg-danger"></div>
            <div class="mb-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="fg-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="fg-danger"></span>
            </div>
            <div class="mb-5">
                <input type="submit" value="Create role" class="btn btn-solid theme-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}