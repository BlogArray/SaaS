@model RoleViewModel

@{
    ViewData["Title"] = "Delete";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">Delete role</h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All roles
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">Delete role @Model.Name</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="sm:col-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="sm:col-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete role" class="btn btn-solid theme-danger" />
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}