@model RoleViewModel

@{
    ViewData["Title"] = "Delete role";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">Delete role</h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All roles
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">Delete role @Model.Name</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="sm:col-2">Name</dt>
            <dd class="sm:col-10">@Model.Name</dd>
            <dt class="sm:col-2">Description</dt>
            <dd class="sm:col-10">@(Model.Description ?? "-")</dd>
            <dt class="sm:col-2">Users</dt>
            <dd class="sm:col-10">@Model.UsersAssigned</dd>
        </dl>

        @if (Model.UsersAssigned > 0)
        {
            <div class="alert theme-warning mb-5" role="alert">
                This role is assigned to @Model.UsersAssigned user(s). Remove it from them (Users &gt; Roles) before deleting it.
            </div>
            <a asp-action="Index" class="btn btn-solid theme-secondary">Back to roles</a>
        }
        else
        {
            <p>The role will be permanently deleted. This can't be undone.</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete role" class="btn btn-solid theme-danger" />
                <a asp-action="Index" class="btn btn-solid theme-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
