@using System.Security.Claims
@{
    ViewData["Title"] = "Create a new user";
}

@model CreateUserViewModel

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">Create a new user</h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All users
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">Create</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="fg-danger"></div>
            <div class="row">
                <div class="col col-12 lg:col-6 mb-5">
                    <label asp-for="FirstName" class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="First name" />
                    <span asp-validation-for="FirstName" class="fg-danger"></span>
                </div>
                <div class="col col-12 lg:col-6 mb-5">
                    <label asp-for="LastName" class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Last name" />
                    <span asp-validation-for="LastName" class="fg-danger"></span>
                </div>
                <div class="col col-12 mb-5">
                    <label asp-for="DisplayName" class="form-label">Display name</label>
                    <input asp-for="DisplayName" class="form-control" placeholder="Display name" />
                    <span asp-validation-for="DisplayName" class="fg-danger"></span>
                </div>
                <div class="col col-12 mb-5">
                    <label asp-for="Email" class="form-label">Email/Username</label>
                    <input asp-for="Email" class="form-control" placeholder="Email address" />
                    <span asp-validation-for="Email" class="fg-danger"></span>
                </div>
            </div>

            <p class="form-text">Please note: A secure password setup link will be sent to the user's email, or to you if you choose that option below. Ensure they follow the link promptly, as it will expire soon for security purposes.</p>

            <div class="mb-5 form-field">
                <input class="check" type="checkbox" asp-for="SendLinkToMe">
                <label hide-indicator="true" asp-for="SendLinkToMe">
                    Email me the password setup link
                </label>
            </div>
            <div class="mb-5">
                <input type="submit" value="Create user" class="btn btn-solid theme-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
