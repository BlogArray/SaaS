@model UserSecurityViewModel
@{
    // Security actions confirm in the same dialog as the toolbar's account actions, with the
    // choice to notify the user by email.
    UserActionDialogViewModel disableMfaDialog = new(Model.Id, "DisableMfa", "Disable 2FA",
        "Two-factor authentication will be turned off. The authenticator stays enrolled, so the user can turn it on again without re-scanning.", Destructive: true,
        "Untick this when responding to a suspected account compromise.");
    UserActionDialogViewModel resetMfaDialog = new(Model.Id, "ResetMfa", "Reset MFA",
        "Two-factor authentication will be turned off and the authenticator enrollment cleared. The user must enroll a new authenticator at their next sign-in.", Destructive: true,
        "Untick this when responding to a suspected account compromise.");
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h6 class="mb-1">Multi-factor authentication</h6>
        @if (Model.TwoFactorEnabled)
        {
            <span class="badge badge-subtle rounded-pill theme-success">Enabled</span>
            @if (Model.HasAuthenticator)
            {
                <span class="badge badge-subtle rounded-pill theme-secondary ms-1">Authenticator app (TOTP)</span>
            }
        }
        else
        {
            <span class="badge badge-subtle rounded-pill theme-secondary">Disabled</span>
        }
    </div>
    <div class="text-nowrap">
        @if (Model.TwoFactorEnabled)
        {
            <button type="button" data-bs-toggle="dialog" data-bs-target="#@disableMfaDialog.DialogId" class="btn btn-sm btn-subtle theme-secondary ms-1" title="Turns 2FA off but keeps the authenticator enrollment">Disable 2FA</button>
            <button type="button" data-bs-toggle="dialog" data-bs-target="#@resetMfaDialog.DialogId" class="btn btn-sm btn-subtle theme-danger ms-1">Reset MFA</button>
            <partial name="_UserActionDialog" model="disableMfaDialog" />
            <partial name="_UserActionDialog" model="resetMfaDialog" />
        }
    </div>
</div>

<h6 class="mt-7 mb-3">Passkeys (@Model.Passkeys.Count)</h6>
@if (Model.Passkeys.Count == 0)
{
    <p class="fg-secondary small mb-0">No passkeys enrolled.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (WebAuthnCredential passkey in Model.Passkeys)
                {
                    <tr>
                        <td>@passkey.Name</td>
                        <td class="fg-secondary small">@passkey.CreatedOn.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td class="fg-secondary small">@(passkey.LastUsedOn?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "never")</td>
                        <td class="text-end">
                            @{
                                UserActionDialogViewModel removePasskeyDialog = new(Model.Id, "RemovePasskey", "Remove passkey",
                                    $"The passkey '{passkey.Name}' will be removed. The user can no longer sign in with it.", Destructive: true,
                                    Key: passkey.Id, Fields: new Dictionary<string, string> { ["credentialId"] = passkey.Id });
                            }
                            <button type="button" data-bs-toggle="dialog" data-bs-target="#@removePasskeyDialog.DialogId" class="btn btn-sm btn-subtle theme-danger">Remove</button>
                            <partial name="_UserActionDialog" model="removePasskeyDialog" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
