@model UserToolbar
@{
    string? currentUser = ViewBag.CurrentUserId;

    // Account actions confirm in a dialog that also asks whether to notify the user.
    UserActionDialogViewModel enableDialog = new(Model.Id, "EnableUser", "Enable user",
        "The user will be able to sign in to their assigned tenants again.", Destructive: false);
    UserActionDialogViewModel disableDialog = new(Model.Id, "DisableUser", "Disable user",
        "The user will be signed out of every device and can no longer sign in to any of their tenants.", Destructive: true,
        "Untick this when offboarding a user or responding to a suspected account compromise.");
    // Unlock ends any lockout - an administrator lock or an automatic one after repeated failed
    // sign-ins - and resets the failed sign-in count, so the user starts with full attempts.
    string lockedUntil = UserToolbar.DescribeLockoutEnd(Model.LockoutEnd);
    string unlockMessage = UserToolbar.IsIndefiniteLockout(Model.LockoutEnd)
        ? "An administrator locked this account until it is unlocked. Unlocking lets the user sign in again and resets their failed sign-in count."
        : $"The account is locked {lockedUntil}, either by an administrator or after repeated failed sign-ins. Unlocking ends the lockout now and resets the failed sign-in count.";
    UserActionDialogViewModel unlockDialog = new(Model.Id, "UnlockUser", "Unlock user", unlockMessage, Destructive: false);
    UserActionDialogViewModel lockDialog = new(Model.Id, "LockUser", "Lock user",
        "The user will be signed out of every device and can't sign in while the account is locked. Choose how long the lock lasts.", Destructive: true,
        "Untick this when responding to a suspected account compromise.", AskLockoutEnd: true);
    UserActionDialogViewModel confirmDialog = new(Model.Id, "ConfirmEmailPhone", "Confirm email",
        "The user's email address (and phone number, if one is set) will be marked as confirmed, so they can sign in without the confirmation link.", Destructive: false);
    UserActionDialogViewModel revokeDialog = new(Model.Id, "RevokeAllSessions", "Revoke sessions",
        "The user will be signed out of every device and app, and any password-reset links they hold stop working. They can sign in again straight away.", Destructive: true,
        "Untick this when responding to a suspected account compromise.");
}
<div class="btn-toolbar mb-3" role="toolbar" aria-label="User actions">
    @if (currentUser == Model.Id)
    {
        <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Profile">
            <a target="_blank" asp-action="Manage" title="Manage your profile" asp-controller="Authentication" asp-area=""
               class="btn btn-subtle theme-secondary" data-bs-toggle="tooltip" data-bs-title="Manage your profile">
                View profile
                <i class="ms-1 bi bi-box-arrow-up-right"></i>
            </a>
        </div>
    }
    else
    {
        @* The action buttons submit the hidden forms below through the form attribute, so each
           button stays a direct child of .btn-group (Bootstrap's group sizing, joined corners
           and dividers only apply to direct children). *@
        <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Account">
            @if (!Model.IsActive)
            {
                <button type="button" data-bs-toggle="dialog" data-bs-target="#@enableDialog.DialogId" class="btn btn-subtle theme-secondary" title="Enable user">Enable user</button>
            }
            else
            {
                <button type="button" data-bs-toggle="dialog" data-bs-target="#@disableDialog.DialogId" class="btn btn-subtle theme-secondary" title="Disable user">Disable user</button>
            }
            @if (!Model.IsEmailPhoneConfirmed)
            {
                <button type="button" data-bs-toggle="dialog" data-bs-target="#@confirmDialog.DialogId" class="btn btn-subtle theme-secondary" title="Mark email and phone as confirmed.">Confirm email/phone</button>
            }
            @* Locked = a lockout end in the future. LockoutEnabled is true for every account and
               only means lockout can apply. *@
            @if (Model.IsLockedOut)
            {
                <button type="button" data-bs-toggle="dialog" data-bs-target="#@unlockDialog.DialogId" class="btn btn-subtle theme-secondary" title="The account is locked @lockedUntil.">Unlock user</button>
            }
            else
            {
                <button type="button" data-bs-toggle="dialog" data-bs-target="#@lockDialog.DialogId" class="btn btn-subtle theme-secondary" title="Prevent the user from logging in by locking their account.">Lock user</button>
            }
            @if (!Model.HasPassword)
            {
                @Html.AjaxActionLink("Resend invite", "ResendInvite", new { id = Model.Id }, new AjaxOptions
       {
           UpdateTargetId = "changeUserInfo",
           OnSuccess = "userEditFormLoaded"
       }, new { @class = "btn btn-subtle theme-secondary", title = "Re-send the onboarding invite email" })
            }
            @* Revoking applies to every account; only "Resend invite" is limited to users who
               have not set a password yet. *@
            <button type="button" data-bs-toggle="dialog" data-bs-target="#@revokeDialog.DialogId" class="btn btn-subtle theme-secondary" title="Revoke all sessions and rotate the security stamp.">Revoke sessions</button>
            @Html.AjaxActionLink("Reset password", "ResetPassword", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeUserInfo",
       OnSuccess = "userEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Reset password" })
        </div>
    }
    <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Tenants">
        @Html.AjaxActionLink($"Tenants ({Model.TenantsCount})", "Unassign", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeUserInfo",
       OnSuccess = "userEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "View all tenants" })
        @Html.AjaxActionLink("Add tenants", "Assign", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeUserInfo",
       OnSuccess = "userEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Add tenants" })
    </div>
</div>
@if (currentUser != Model.Id)
{
    if (!Model.IsActive)
    {
        <partial name="_UserActionDialog" model="enableDialog" />
    }
    else
    {
        <partial name="_UserActionDialog" model="disableDialog" />
    }
    if (Model.IsLockedOut)
    {
        <partial name="_UserActionDialog" model="unlockDialog" />
    }
    else
    {
        <partial name="_UserActionDialog" model="lockDialog" />
    }
    if (!Model.IsEmailPhoneConfirmed)
    {
        <partial name="_UserActionDialog" model="confirmDialog" />
    }
    <partial name="_UserActionDialog" model="revokeDialog" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}