@using System.Security.Claims
@{
    ViewData["Title"] = $"User > {Model.DisplayName}";
}

@model EditUserViewModel

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">
            <img height="34" alt="profile icon" class="flex-shrink-0 me-1 rounded" loading="lazy" id="faviconImage" src="@Model.ProfileImage" />
            @Model.DisplayName
        </h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All users
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">@Model.DisplayName</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        @Html.DynamicContentLoader("toolbar", Url.Action("Toolbar", "Users", new { @id = Model.Id }))
        @Html.DynamicContentLoader("basicInfo", Url.Action("BasicInfo", "Users", new { @id = Model.Id }))
        <hr class="my-5">
        @Html.DynamicContentLoader("userRoles", Url.Action("Roles", "Users", new { @id = Model.Id }))
        <hr class="my-5">
        @Html.DynamicContentLoader("security", Url.Action("Security", "Users", new { @id = Model.Id }))
        <hr class="my-5">
        @Html.DynamicContentLoader("sessions", Url.Action("Sessions", "Users", new { @id = Model.Id }))
    </div>
</div>

<div id="changeUserInfo"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    var userEditCanvas;

    function userEditFormLoaded() {
        userEditCanvas = new bootstrap.Drawer(document.getElementById('userEditOffcanvas'));
        userEditCanvas.show();
    }

     function onUserChangeSuccess(e) {
        DynamicContentLoader.load('toolbar');
        DynamicContentLoader.load('basicInfo');
        DynamicContentLoader.load('security');
        DynamicContentLoader.load('sessions');
        onUserChange(e);
    }

    function onUserRoleChangeSuccess(e) {
        DynamicContentLoader.load('userRoles');
        onUserChange(e);
    }

    function securityChanged(e) {
        DynamicContentLoader.load('security');
        DynamicContentLoader.load('sessions');
        Toast.success(e.message);
    }

    function sessionsChanged(e) {
        DynamicContentLoader.load('sessions');
        Toast.success(e.message);
    }

    function onUserChange(e){
        userEditCanvas.hide();
        Toast.success(e.message);
    }

    // Account action dialogs (enable/disable/lock/unlock, _UserActionDialog). Unobtrusive Ajax
    // calls these with the form as `this`. The confirm button is disabled while the request
    // runs, so a double click cannot submit twice; on failure the dialog stays open (the global
    // error dialog shows the reason) and can be corrected and retried.
    function beginUserAction() {
        this.querySelectorAll('[type="submit"]').forEach(function (button) { button.disabled = true; });
    }

    function completeUserAction() {
        this.querySelectorAll('[type="submit"]').forEach(function (button) { button.disabled = false; });
    }

    // The dialog lives in the toolbar, which reloads after the action: close it first and
    // reload only once it has finished closing, so the reload never removes an open dialog.
    function onAccountActionSuccess(e) {
        const dialog = this.closest('dialog');

        if (dialog && dialog.open) {
            dialog.addEventListener('hidden.bs.dialog', function () { changeState(e); }, { once: true });
            bootstrap.Dialog.getOrCreateInstance(dialog).hide();
        } else {
            changeState(e);
        }
    }

    // Lock dialog: "Until a date and time" reveals the picker (no past times), and the picked
    // local time is posted as UTC in lockoutEndUtc. Delegated because the toolbar - and the
    // dialog inside it - is reloaded after every action.
    document.addEventListener('change', function (e) {
        const target = e.target;

        if (target.matches('[data-lockout-mode]')) {
            const form = target.form;
            const timed = target.value === 'until';
            const picker = form.querySelector('[data-lockout-local]');

            form.querySelector('[data-lockout-until]').hidden = !timed;

            if (timed) {
                // The server requires the lock to end more than a minute from now: start the
                // allowed range a few minutes ahead (datetime-local wants local time, no zone).
                const earliest = new Date(Date.now() + 5 * 60 * 1000);
                earliest.setMinutes(earliest.getMinutes() - earliest.getTimezoneOffset());
                picker.min = earliest.toISOString().slice(0, 16);
                picker.required = true;
                picker.focus();
            } else {
                picker.required = false;
                picker.value = '';
                form.querySelector('[data-lockout-utc]').value = '';
            }
        }

        if (target.matches('[data-lockout-local]')) {
            syncLockoutUtc(target);
        }
    });

    // Typed values may only raise "input" until the field loses focus, so keep the UTC copy in
    // step on every edit, not only on "change".
    document.addEventListener('input', function (e) {
        if (e.target.matches('[data-lockout-local]')) {
            syncLockoutUtc(e.target);
        }
    });

    function syncLockoutUtc(picker) {
        const local = picker.value ? new Date(picker.value) : null;
        picker.form.querySelector('[data-lockout-utc]').value = local && !isNaN(local) ? local.toISOString() : '';
    }

    function changeState(e){
        DynamicContentLoader.load('toolbar');
        DynamicContentLoader.load('basicInfo');
        // Disable, lock and revoke sessions end the user's sessions: refresh that panel too.
        DynamicContentLoader.load('sessions');
        Toast.success(e.message);
    }
</script>