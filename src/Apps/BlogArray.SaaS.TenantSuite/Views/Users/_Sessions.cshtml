@model List<UserSession>
@{
    string? userId = Model.FirstOrDefault()?.UserId;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <h6 class="mb-0">Active sessions (@Model.Count(s => !s.Revoked))</h6>
    @if (userId is not null && Model.Count(s => !s.Revoked) > 0)
    {
        @* Same dialog as the toolbar's Revoke sessions (its own key: both can be on the page). *@
        UserActionDialogViewModel revokeAllDialog = new(userId, "RevokeAllSessions", "Revoke all sessions",
            "The user will be signed out of every device and app, and any password-reset links they hold stop working. They can sign in again straight away.", Destructive: true,
            "Untick this when responding to a suspected account compromise.", Key: "panel");
        <button type="button" data-bs-toggle="dialog" data-bs-target="#@revokeAllDialog.DialogId" class="btn btn-sm btn-subtle theme-danger">Revoke all sessions</button>
        <partial name="_UserActionDialog" model="revokeAllDialog" />
    }
</div>

@if (Model.Count == 0)
{
    <p class="fg-secondary small mb-0">No tracked sessions.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>IP address</th>
                    <th>Signed in</th>
                    <th>Last seen</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserSession session in Model)
                {
                    <tr class="@(session.Revoked ? "fg-secondary" : "")">
                        <td class="text-truncate" style="max-width:180px" title="@session.UserAgent">@session.DeviceName</td>
                        <td class="fg-secondary small">@session.IpAddress</td>
                        <td class="fg-secondary small">@(DateTime.SpecifyKind(session.CreatedOn, DateTimeKind.Utc).ToString("dd'-'MM'-'yyyy HH':'mm", System.Globalization.CultureInfo.InvariantCulture)) UTC</td>
                        <td class="fg-secondary small">@(DateTime.SpecifyKind(session.LastSeenOn, DateTimeKind.Utc).ToString("dd'-'MM'-'yyyy HH':'mm", System.Globalization.CultureInfo.InvariantCulture)) UTC</td>
                        <td>
                            @if (session.Revoked)
                            {
                                <span class="badge badge-subtle rounded-pill theme-secondary">Revoked</span>
                            }
                            else
                            {
                                <span class="badge badge-subtle rounded-pill theme-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!session.Revoked)
                            {
                                UserActionDialogViewModel revokeSessionDialog = new(session.UserId, "RevokeSession", "Revoke session",
                                    $"The session on '{session.DeviceName}' ({session.IpAddress}) will be signed out. The user can sign in again on that device.", Destructive: true,
                                    "Untick this when responding to a suspected account compromise.",
                                    Key: session.Id, Fields: new Dictionary<string, string> { ["sessionId"] = session.SessionId });
                                <button type="button" data-bs-toggle="dialog" data-bs-target="#@revokeSessionDialog.DialogId" class="btn btn-sm btn-subtle theme-danger">Revoke</button>
                                <partial name="_UserActionDialog" model="revokeSessionDialog" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
