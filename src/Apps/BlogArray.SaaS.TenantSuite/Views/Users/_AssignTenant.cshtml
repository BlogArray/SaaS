@model AssignTenantViewModel

@using (Html.AjaxBeginForm(new AjaxOptions
 {
     Url = @Url.ActionLink("Assign"),
     HttpMethod = "post",
	 OnSuccess = "onUserChangeSuccess",
     OnFailure = "handleAjaxError"
 }, new { id = "saveAssignForm" }))
{
	<dialog class="drawer drawer-end medium" tabindex="-1" id="userEditOffcanvas" aria-labelledby="offcanvasRightLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="drawer-header border-bottom">
            <h5 id="offcanvasRightLabel">
                Add tenants to @Model.Name
            </h5>
            <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
            <input type="hidden" asp-for="UserId" />
            <select id="tenantSearch" data-placeholder="Start typing to search..."></select>
			<select asp-for="Tenants" multiple class="d-none"></select>
            <div class="list-group list-group-flush mt-3" id="tenantsList">
            </div>
        </div>
        <div class="drawer-footer border-top">
            <div>
				<input type="submit" value="Assign tenants" class="btn btn-solid theme-primary" />
                <input type="button" value="Cancel" class="btn btn-solid theme-secondary" data-bs-dismiss="drawer" aria-label="Close" />
            </div>
        </div>
    </dialog>
}

<script>
	function escapeHtml(value) {
		return value == null ? '' : String(value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;');
	}

	$(document).ready(function() {
		Unobtrusive.reInit($("#saveAssignForm"));

		const choices = new Choices('#tenantSearch', {
			placeholderValue: 'Search for tenants...',
			searchEnabled: true,
			searchResultLimit: 10,
			noResultsText: 'No tenants found',
			noChoicesText: 'Start typing to search...',
			shouldSort: false,
			removeItemButton: true,
			callbackOnCreateTemplates: function(template) {
				return {
					item: (classNames, data) => {
						return template(`
				<div class="${classNames.item} ${data.highlighted ? classNames.highlightedState : classNames.itemSelectable}" data-item data-id="${data.id}" data-value="${data.value}" ${data.active ? 'aria-selected="true"' : ''}>
				  ${escapeHtml(data.label)}
				</div>
			  `);
					},
					choice: (classNames, data) => {
						return template(`
				<div class="d-flex gap-5 p-5 ${classNames.item} ${classNames.itemChoice}" data-select-text="${this.config.itemSelectText}" data-choice data-id="${data.id}" data-value="${data.value}" ${data.active ? 'aria-selected="true"' : ''} ${data.disabled ? 'aria-disabled="true"' : ''}>
				<img src="${escapeHtml(data.customProperties?.profileUrl || '/default-profile.png')}" alt="tenant icon" width="32" height="32" class="rounded-circle flex-shrink-0">
				  <div class="d-flex gap-3 w-100 justify-content-between">
					<div>
					  <h6 class="mb-0">${escapeHtml(data.label)}</h6>
					  <p class="mb-0 opacity-75">${escapeHtml(data.customProperties?.clientId)}</p>
					</div>
				  </div>
				</div>
			  `);
					}
				};
			}
		});

		choices.passedElement.element.addEventListener('search', async function(event) {
			const searchTerm = event.detail.value;
			if (searchTerm) {
				const response = await fetch(`@Url.Action("Search", "Tenants")?term=${encodeURIComponent(searchTerm)}`);
				const tenants = await response.json();
				choices.clearChoices();
				tenants.forEach(tenant => {
					choices.setChoices([{
						value: tenant.id,
						label: tenant.displayName,
						customProperties: {
							clientId: tenant.clientId,
							profileUrl: tenant.icon
						}
					}], 'value', 'label', false);
				});
			}
		});
		const tenantsList = document.getElementById('tenantsList');

		const tenantsSelect = document.querySelector('select[multiple][name="Tenants"]');

		choices.passedElement.element.addEventListener('choice', function(event) {
			const selectedUser = event.detail;

			const option = document.createElement('option');
			option.value = selectedUser.value;
			option.selected = true;
			option.textContent = selectedUser.label;
			tenantsSelect.appendChild(option);

			const tenantDiv = document.createElement('div');
			tenantDiv.classList.add('list-group-item', 'list-group-item-action', 'd-flex', 'gap-5', 'py-5');

			const img = document.createElement('img');
			img.src = selectedUser.customProperties?.profileUrl || '/default-profile.png';
			img.alt = 'tenant icon';
			img.width = 32;
			img.height = 32;
			img.classList.add('rounded-circle', 'flex-shrink-0');
			tenantDiv.appendChild(img);

			const textWrapper = document.createElement('div');
			textWrapper.classList.add('d-flex', 'gap-3', 'w-100', 'justify-content-between');

			const textContainer = document.createElement('div');

			const nameHeading = document.createElement('h6');
			nameHeading.classList.add('mb-0');
			nameHeading.textContent = selectedUser.label;
			textContainer.appendChild(nameHeading);

			const clientIdParagraph = document.createElement('p');
			clientIdParagraph.classList.add('mb-0', 'opacity-75');
			clientIdParagraph.textContent = selectedUser.customProperties?.clientId;
			textContainer.appendChild(clientIdParagraph);

			textWrapper.appendChild(textContainer);

			const removeButton = document.createElement('button');
			removeButton.type = 'button';
			removeButton.classList.add('btn-close', 'remove-tenant');
			removeButton.setAttribute('aria-label', 'Remove');
			textWrapper.appendChild(removeButton);

			tenantDiv.appendChild(textWrapper);

			tenantsList.appendChild(tenantDiv);
			tenantDiv.querySelector('.remove-tenant').addEventListener('click', function() {
				// Remove the div from tenantsList
				tenantDiv.remove();
				// Remove the corresponding option from tenantsSelect
				Array.from(tenantsSelect.options).forEach(option => {
					if (option.value === selectedUser.value) {
						option.remove();
					}
				});
			});
		});
	});
</script>
