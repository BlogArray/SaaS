@model UserRolesViewModel

@using (Html.AjaxBeginForm(new AjaxOptions
 {
     Url = @Url.ActionLink("EditRoles"),
     HttpMethod = "post",
     OnSuccess = "onUserRoleChangeSuccess",
     OnFailure = "handleAjaxError"
 }, new { id = "saveUserForm" }))
{
    <dialog class="drawer drawer-end medium" tabindex="-1" id="userEditOffcanvas" aria-labelledby="offcanvasRightLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="drawer-header border-bottom">
            <h5 id="offcanvasRightLabel">
                Update roles
            </h5>
            <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
            <div asp-validation-summary="ModelOnly" class="fg-danger"></div>
            <input asp-for="UserId" type="hidden" />
            <div class="mb-5">
                <label asp-for="RolesSelected" class="form-label">Select roles</label>
                <select multiple class="form-control" asp-for="RolesSelected" asp-items="Model.Roles">
                </select>
                <span asp-validation-for="RolesSelected" class="fg-danger"></span>
            </div>
            <div class="form-field mt-5">
                <input class="check" type="checkbox" name="notify" value="true" id="rolesNotify" checked />
                <label hide-indicator="true" for="rolesNotify">Email the user about the role change</label>
            </div>
            @* Posted when the box is unchecked (checked posts "true" first, which wins). Untick when
               offboarding or responding to a suspected account compromise. *@
            <input type="hidden" name="notify" value="false" />
        </div>
        <div class="drawer-footer border-top">
            <div>
                <input type="submit" value="Update roles" class="btn btn-solid theme-primary" />
                <input type="button" value="Cancel" class="btn btn-solid theme-secondary" data-bs-dismiss="drawer" aria-label="Close" />
            </div>
        </div>
    </dialog>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    var rolesChoice, timeZoneChoice, localeChoice;

    $(document).ready(function () {
        Unobtrusive.reInit($("#saveUserForm"));

        rolesChoice = new Choices('#RolesSelected', {
            searchPlaceholderValue: 'Please search',
            placeholderValue: 'Please select a role',
            shouldSort: false,
            removeItems: true,
            removeItemButton: true,
        });
    });
</script>