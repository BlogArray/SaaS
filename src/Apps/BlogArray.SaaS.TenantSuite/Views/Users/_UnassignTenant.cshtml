@model AssignTenantViewModel

@using (Html.AjaxBeginForm(new AjaxOptions
 {
     Url = @Url.ActionLink("Unassign"),
     HttpMethod = "post",
     OnSuccess = "onUserChangeSuccess",
     OnFailure = "handleAjaxError"
 }, new { id = "saveUnassignForm" }))
{
    <dialog class="drawer drawer-end medium" tabindex="-1" id="userEditOffcanvas" aria-labelledby="offcanvasRightLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="drawer-header border-bottom">
            <h5 id="offcanvasRightLabel">
                Remove tenants from @Model.Name
            </h5>
            <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
            <input type="hidden" asp-for="UserId" />
            <div class="list-group list-group-flush">
                @if (Model.Tenants?.Count() == 0)
                {
                    <div class="p-12 text-center">
                        <i class="state-icon bi bi-inbox"></i>
                        <br />
                        <p class="fg-body fs-xl fw-semibold mb-0">
                            No tenants assigned to this user yet.
                        </p>
                        <p class="lg:col-8 mx-auto fs-md fg-secondary">
                            To grant access click on <i class="bi bi-person-add"></i> icon.
                        </p>
                    </div>
                }
                else
                {
                    <span class="form-text">
                        Select tenants to remove
                    </span>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <label class="list-group-item d-flex gap-5">
                            <input class="check flex-shrink-0" type="checkbox" value="@tenant.Id" name="Tenants" id="@tenant.Id" style="font-size: 1.375em;">
                            <span class="form-checked-content">
                                <strong>@tenant.DisplayName</strong>
                                <small class="d-block fg-secondary">
                                    @tenant.ClientId
                                </small>
                            </span>
                        </label>
                    }
                }
            </div>
        </div>
        <div class="drawer-footer border-top">
            <div>
                @if (Model.Tenants?.Count() > 0)
                {
                    <input type="submit" value="Remove selected tenants" class="btn btn-solid theme-primary" />
                }
                <input type="button" value="Cancel" class="btn btn-solid theme-secondary" data-bs-dismiss="drawer" aria-label="Close" />
            </div>
        </div>
    </dialog>
}

<script>
    $(document).ready(function () {
        Unobtrusive.reInit($("#saveUnassignForm"));
    });
</script>