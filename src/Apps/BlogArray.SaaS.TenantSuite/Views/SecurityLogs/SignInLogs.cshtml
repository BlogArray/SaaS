@model IPager<SignInLogEntry>

@{
    ViewData["Title"] = "Sign-in logs";
    string? searchTerm = ViewBag.SearchTerm as string;
    string? tenantId = ViewBag.SelectedTenantId as string;
    bool isSuperuser = User.IsInRole("Superuser");
}

<h3>Sign-in logs</h3>

<div class="card">
    <div class="card-header">
        <form asp-action="SignInLogs" method="get" class="row gx-3">
            @if (isSuperuser)
            {
                <div class="col-auto">
                    <select name="tenantId" class="form-control" onchange="this.form.submit()">
                        <option value="">All tenants</option>
                        @foreach (SelectListItem tenant in (IEnumerable<SelectListItem>)ViewBag.Tenants!)
                        {
                            if (tenant.Value == tenantId)
                            {
                                <option value="@tenant.Value" selected>@tenant.Text</option>
                            }
                            else
                            {
                                <option value="@tenant.Value">@tenant.Text</option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col">
                <div class="input-group">
                    <input type="text" name="term" value="@searchTerm" class="form-control" placeholder="Search by user, email, IP address, event or tenant..." aria-label="Search">
                    <button class="btn btn-subtle theme-secondary" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <div class="card-body py-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="min-width:200px">User</th>
                        <th style="min-width:150px">Application</th>
                        <th style="min-width:110px">Event</th>
                        <th style="min-width:110px">Method</th>
                        <th style="min-width:110px">Result</th>
                        <th style="min-width:120px">IP address</th>
                        <th style="min-width:150px">Device</th>
                        <th style="min-width:150px">Date</th>
                        <th class="text-end" style="width:80px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (SignInLogEntry entry in Model)
                    {
                        bool failed = entry.Result == "Failure";
                        <tr>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width:200px">@entry.DisplayName</div>
                                <div class="fg-secondary small text-truncate" style="max-width:200px" title="@entry.Email">@entry.Email</div>
                            </td>
                            <td class="text-truncate small" style="max-width:150px" title="@entry.TenantName">@entry.TenantName</td>
                            <td class="small">@entry.EventType</td>
                            <td class="small">@entry.AuthMethod</td>
                            <td>
                                <span class="badge badge-subtle rounded-pill theme-@(failed ? "danger" : "success")">
                                    @(entry.EventType is SignInEventTypes.AccountLockedRepeatedFailures or SignInEventTypes.LoginBlockedLockedOut ? "Locked out" : failed ? "Failed" : "Success")
                                </span>
                            </td>
                            <td class="fg-secondary small">@entry.IpAddress</td>
                            <td class="fg-secondary small text-truncate" style="max-width:150px" title="@entry.DeviceInfo">@entry.DeviceInfo</td>
                            @{
                                // Stored in UTC (read back without a kind): shown in the viewer's
                                // time zone by the script below, UTC as the fallback and tooltip.
                                DateTime createdUtc = DateTime.SpecifyKind(entry.CreatedOn, DateTimeKind.Utc);
                            }
                            <td class="fg-secondary small"><time datetime="@createdUtc.ToString("yyyy'-'MM'-'dd'T'HH':'mm':'ss'Z'", System.Globalization.CultureInfo.InvariantCulture)" data-local-time>@createdUtc.ToString("dd'-'MM'-'yyyy HH':'mm':'ss", System.Globalization.CultureInfo.InvariantCulture) UTC</time></td>
                            <td class="text-end">
                                @Html.AjaxActionLink("View", "SignInLogDetails", new { id = entry.Id }, new AjaxOptions
       {
           UpdateTargetId = "logDetails",
           OnSuccess = "logDetailsLoaded"
       }, new { @class = "btn btn-sm btn-subtle theme-secondary", title = "View all details" })
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center fg-secondary py-7">No sign-in events match the current filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="logDetails"></div>

@if (Model.Count() > 0)
{
    <div class="mt-3">
        @Html.Pager((IPager)Model, page => Url.Action("SignInLogs", "SecurityLogs", new { page, take = ViewBag.Take, term = searchTerm, tenantId }), PrePagerOptions.MinimalWithEntriesText)
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    var logDetailsCanvas;

    // Event times are rendered in UTC; show them in the viewer's own time zone, keeping the UTC
    // value as the tooltip.
    function showLocalTimes(root) {
        (root || document).querySelectorAll('time[data-local-time]').forEach(function (element) {
            const date = new Date(element.dateTime);

            if (isNaN(date)) {
                return;
            }

            element.title = element.textContent.trim();
            element.textContent = date.toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'medium' });
            element.removeAttribute('data-local-time');
        });
    }

    showLocalTimes();

    function logDetailsLoaded() {
        const drawer = document.getElementById('logDetailsOffcanvas');
        showLocalTimes(drawer);
        logDetailsCanvas = new bootstrap.Drawer(drawer);
        logDetailsCanvas.show();
    }
</script>
