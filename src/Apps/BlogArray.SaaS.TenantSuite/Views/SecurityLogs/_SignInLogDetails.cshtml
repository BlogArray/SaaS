@model SignInLogEntry

<dialog class="drawer drawer-end medium" tabindex="-1" id="logDetailsOffcanvas" aria-labelledby="logDetailsOffcanvasLabel" data-bs-backdrop="static">
    <div class="drawer-header border-bottom">
        <h5 class="drawer-title" id="logDetailsOffcanvasLabel">Sign-in event details</h5>
        <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
    </div>
    <div class="drawer-body">
        <dl class="row mb-0">
            <dt class="sm:col-4">Event type</dt>
            <dd class="sm:col-8">@Model.EventType</dd>

            <dt class="sm:col-4">User</dt>
            <dd class="sm:col-8">
                <div class="fw-semibold">@Model.DisplayName</div>
                <div class="fg-secondary small">@Model.Email</div>
                <div class="fg-secondary small">@Model.UserId</div>
            </dd>

            <dt class="sm:col-4">Application</dt>
            <dd class="sm:col-8">
                @(Model.TenantName ?? "-")
                @if (!string.IsNullOrEmpty(Model.ClientId))
                {
                    <div class="fg-secondary small">@Model.ClientId</div>
                }
            </dd>

            <dt class="sm:col-4">Authentication method</dt>
            <dd class="sm:col-8">@(Model.AuthMethod ?? "-")</dd>

            <dt class="sm:col-4">Result</dt>
            <dd class="sm:col-8">@Model.Result</dd>

            <dt class="sm:col-4">Details</dt>
            <dd class="sm:col-8">@(Model.Details ?? "-")</dd>

            <dt class="sm:col-4">IP address</dt>
            <dd class="sm:col-8">@(Model.IpAddress ?? "-")</dd>

            <dt class="sm:col-4">Device</dt>
            <dd class="sm:col-8">@(Model.DeviceInfo ?? "-")</dd>

            <dt class="sm:col-4">User agent</dt>
            <dd class="sm:col-8 text-wrap small">@(Model.UserAgent ?? "-")</dd>

            <dt class="sm:col-4">Time (UTC)</dt>
            <dd class="sm:col-8">@Model.CreatedOn.ToUniversalTime().ToString("O")</dd>

            <dt class="sm:col-4">Time (local)</dt>
            <dd class="sm:col-8">@Model.CreatedOn.ToLocalTime().ToString("g")</dd>
        </dl>
    </div>
</dialog>
