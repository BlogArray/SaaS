@model AuditLogEntry

<dialog class="drawer drawer-end medium" tabindex="-1" id="logDetailsOffcanvas" aria-labelledby="logDetailsOffcanvasLabel" data-bs-backdrop="static">
    <div class="drawer-header border-bottom">
        <h5 class="drawer-title" id="logDetailsOffcanvasLabel">Audit event details</h5>
        <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
    </div>
    <div class="drawer-body">
        <dl class="row mb-0">
            <dt class="sm:col-4">Activity</dt>
            <dd class="sm:col-8">@Model.EventType</dd>

            <dt class="sm:col-4">Initiated by</dt>
            <dd class="sm:col-8">
                <div class="fw-semibold">@Model.ActorDisplayName <span class="badge badge-subtle rounded-pill theme-secondary">via @Model.TriggeredBy</span></div>
                <div class="fg-secondary small">@Model.ActorEmail</div>
                <div class="fg-secondary small">@Model.UserId</div>
            </dd>

            @if (!string.IsNullOrEmpty(Model.TargetUserId))
            {
                <dt class="sm:col-4">Target user</dt>
                <dd class="sm:col-8">
                    @if (!string.IsNullOrEmpty(Model.TargetDisplayName) || !string.IsNullOrEmpty(Model.TargetEmail))
                    {
                        <div class="fw-semibold">@Model.TargetDisplayName</div>
                        <div class="fg-secondary small">@Model.TargetEmail</div>
                    }
                    <div class="fg-secondary small">@Model.TargetUserId</div>
                </dd>
            }

            <dt class="sm:col-4">Application</dt>
            <dd class="sm:col-8">
                @(Model.TenantName ?? "-")
                @if (!string.IsNullOrEmpty(Model.ClientId))
                {
                    <div class="fg-secondary small">@Model.ClientId</div>
                }
            </dd>

            <dt class="sm:col-4">Reason</dt>
            <dd class="sm:col-8">@(Model.Reason ?? "-")</dd>

            @if (!string.IsNullOrEmpty(Model.ChangeSummary))
            {
                <dt class="sm:col-4">Changes</dt>
                <dd class="sm:col-8 white-space-pre-line">@Model.ChangeSummary</dd>
            }

            @if (!string.IsNullOrEmpty(Model.OldValue))
            {
                <dt class="sm:col-4">Old value</dt>
                <dd class="sm:col-8 text-wrap"><code class="small">@Model.OldValue</code></dd>
            }

            @if (!string.IsNullOrEmpty(Model.NewValue))
            {
                <dt class="sm:col-4">New value</dt>
                <dd class="sm:col-8 text-wrap"><code class="small">@Model.NewValue</code></dd>
            }

            <dt class="sm:col-4">IP address</dt>
            <dd class="sm:col-8">@(Model.IpAddress ?? "-")</dd>

            <dt class="sm:col-4">Device</dt>
            <dd class="sm:col-8">@(Model.DeviceInfo ?? "-")</dd>

            <dt class="sm:col-4">User agent</dt>
            <dd class="sm:col-8 text-wrap small">@(Model.UserAgent ?? "-")</dd>

            @{
                // Stored in UTC but read back without a kind: converting it would treat it as
                // server-local time. The viewer's local time is filled in by the page script.
                DateTime createdUtc = DateTime.SpecifyKind(Model.CreatedOn, DateTimeKind.Utc);
            }
            <dt class="sm:col-4">Time (UTC)</dt>
            <dd class="sm:col-8">@createdUtc.ToString("yyyy'-'MM'-'dd HH':'mm':'ss", System.Globalization.CultureInfo.InvariantCulture) UTC</dd>

            <dt class="sm:col-4">Your local time</dt>
            <dd class="sm:col-8"><time datetime="@createdUtc.ToString("yyyy'-'MM'-'dd'T'HH':'mm':'ss'Z'", System.Globalization.CultureInfo.InvariantCulture)" data-local-time>@createdUtc.ToString("yyyy'-'MM'-'dd HH':'mm':'ss", System.Globalization.CultureInfo.InvariantCulture) UTC</time></dd>
        </dl>
    </div>
</dialog>
