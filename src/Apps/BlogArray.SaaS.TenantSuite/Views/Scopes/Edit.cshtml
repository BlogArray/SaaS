@model ScopeViewModel

@{
    string title = $"Edit {Model.Name}";
    ViewData["Title"] = title + " scope";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">@title</h3>
        <p class="mb-0 form-text">
            Edit a scope
        </p>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="fg-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-5">
                <label asp-for="DisplayName" class="form-label">Display name</label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="fg-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Name" class="form-label"></label>
                @if (Model.UsedByTenants.Count > 0)
                {
                    @* Tenants are permitted this scope by name: it can't change while they use it. *@
                    <input asp-for="Name" class="form-control" readonly />
                    <div class="form-text">Used by @string.Join(", ", Model.UsedByTenants), so the name can't be changed.</div>
                }
                else
                {
                    <input asp-for="Name" class="form-control" />
                    <div class="form-text">Letters, digits and . _ - : / only, e.g. orders.read. Not used by any tenant.</div>
                }
                <span asp-validation-for="Name" class="fg-danger"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="fg-danger"></span>
            </div>
            <div class="mb-5">
                <input type="submit" value="Update scope" class="btn btn-solid theme-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}