@model ScopeViewModel

@{
    ViewData["Title"] = "Delete scope";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">Delete scope</h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All scopes
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">Delete scope @Model.Name</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="sm:col-2">Name</dt>
            <dd class="sm:col-10"><code>@Model.Name</code></dd>
            <dt class="sm:col-2">Display name</dt>
            <dd class="sm:col-10">@Model.DisplayName</dd>
            <dt class="sm:col-2">Description</dt>
            <dd class="sm:col-10">@(Model.Description ?? "-")</dd>
            <dt class="sm:col-2">Resources</dt>
            <dd class="sm:col-10">@(Model.Resources.Count > 0 ? string.Join(", ", Model.Resources) : "None")</dd>
            <dt class="sm:col-2">Used by</dt>
            <dd class="sm:col-10">@(Model.UsedByTenants.Count > 0 ? string.Join(", ", Model.UsedByTenants) : "No tenants")</dd>
        </dl>

        @if (Model.UsedByTenants.Count > 0)
        {
            <div class="alert theme-warning mb-5" role="alert">
                Tenants are allowed to request this scope, so it can't be deleted: @string.Join(", ", Model.UsedByTenants).
            </div>
            <a asp-action="Index" class="btn btn-solid theme-secondary">Back to scopes</a>
        }
        else
        {
            <p>The scope will be permanently deleted. This can't be undone.</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete scope" class="btn btn-solid theme-danger" />
                <a asp-action="Index" class="btn btn-solid theme-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
