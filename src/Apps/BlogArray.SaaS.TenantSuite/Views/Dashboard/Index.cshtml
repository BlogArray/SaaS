    @model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    int tenantDelta = Model.NewApplications - Model.PrevNewApplications;
    string tenantDeltaIcon = tenantDelta > 0 ? "bi-arrow-up" : tenantDelta < 0 ? "bi-arrow-down" : "bi-dash";
    string tenantDeltaColor = tenantDelta > 0 ? "fg-success" : tenantDelta < 0 ? "fg-danger" : "fg-secondary";

    int userDelta = Model.NewUsers - Model.PrevNewUsers;
    string userDeltaIcon = userDelta > 0 ? "bi-arrow-up" : userDelta < 0 ? "bi-arrow-down" : "bi-dash";
    string userDeltaColor = userDelta > 0 ? "fg-success" : userDelta < 0 ? "fg-danger" : "fg-secondary";

    int mfaAdoption = Model.Users > 0 ? (int)Math.Round(100.0 * Model.MfaEnabledUsers / Model.Users) : 0;

    var maxTrend = Model.SignInTrend.Count > 0 ? Model.SignInTrend.Max(point => point.Total) : 0;
}

<h3 class="d-flex justify-content-between align-items-center">
    Dashboard
    <span class="fs-md">
        <a asp-action="Create" asp-controller="Tenants" class="btn btn-sm btn-solid theme-primary"><i class="bi bi-plus-lg me-1"></i>New tenant</a>
        <a asp-action="Index" asp-controller="Users" class="btn btn-sm btn-subtle theme-secondary"><i class="bi bi-people me-1"></i>Users</a>
        <a asp-action="SignInLogs" asp-controller="SecurityLogs" class="btn btn-sm btn-subtle theme-secondary"><i class="bi bi-box-arrow-in-right me-1"></i>Sign-in logs</a>
        <a asp-action="AuditLogs" asp-controller="SecurityLogs" class="btn btn-sm btn-subtle theme-secondary"><i class="bi bi-journal-text me-1"></i>Audit logs</a>
    </span>
</h3>

<div class="row g-5 mb-5">
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Tenants</span>
                <h2 class="fw-bold lh-1 my-3">@Model.Applications</h2>
                <span class="d-flex justify-content-between align-items-center">
                    <span class="fg-secondary small">New in last 30 days</span>
                    <span class="small @tenantDeltaColor">
                        <i class="bi @tenantDeltaIcon"></i>
                        @Model.NewApplications <span class="fg-secondary">(prev: @Model.PrevNewApplications)</span>
                    </span>
                </span>
            </div>
        </div>
    </div>
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Users</span>
                <h2 class="fw-bold lh-1 my-3">@Model.Users</h2>
                <span class="d-flex justify-content-between align-items-center">
                    <span class="fg-secondary small">New in last 30 days</span>
                    <span class="small @userDeltaColor">
                        <i class="bi @userDeltaIcon"></i>
                        @Model.NewUsers <span class="fg-secondary">(prev: @Model.PrevNewUsers)</span>
                    </span>
                </span>
            </div>
        </div>
    </div>
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Active sessions</span>
                <h2 class="fw-bold lh-1 my-3">@Model.ActiveSessions</h2>
                <span class="fg-secondary small">Sessions seen in the last 30 minutes</span>
            </div>
        </div>
    </div>
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">MFA adoption</span>
                <h2 class="fw-bold lh-1 my-3">@mfaAdoption%</h2>
                <div class="progress" style="height:6px" title="@Model.MfaEnabledUsers of @Model.Users users">
                    <div class="progress-bar bg-success" style="width:@mfaAdoption%"></div>
                </div>
                <span class="fg-secondary small">@Model.Passkeys passkey(s) enrolled</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-5 mb-5">
    <div class="xl:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Sign-in activity (7 days)</span>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span><i class="bi bi-box-arrow-in-right fg-success me-1"></i>@Model.SuccessfulSignIns successful</span>
                    <span><i class="bi bi-x-octagon fg-danger me-1"></i>@Model.FailedSignIns failed</span>
                    <span><i class="bi bi-slash-circle fg-warning me-1"></i>@Model.Lockouts locked</span>
                </div>
            </div>
        </div>
    </div>
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Pending onboarding</span>
                <h2 class="fw-bold lh-1 my-3">@Model.PendingOnboarding</h2>
                <span class="fg-secondary small">Invited users without a password</span>
            </div>
        </div>
    </div>
    <div class="xl:col-3 md:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <span class="small text-uppercase fw-semibold fg-3">Locked out</span>
                <h2 class="fw-bold lh-1 my-3">@Model.LockedOutUsers</h2>
                <span class="fg-secondary small">Currently locked accounts</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-5 mb-5">
    <div class="col-12">
        <div class="card h-100">
            <div class="p-7">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-uppercase fw-semibold fg-3">Sign-ins — last 14 days</span>
                    <span class="fg-secondary small">total sign-ins per day</span>
                </div>
                <div class="d-flex align-items-end gap-1 mt-3" style="height:180px">
                    @foreach (SignInTrendPoint point in Model.SignInTrend)
                    {
                        int height = maxTrend == 0 ? 4 : Math.Max(6, (int)Math.Round(100.0 * point.Total / maxTrend));
                        <div class="flex-fill text-center">
                            <div class="mx-auto rounded-top trend-bar" style="height:@(height)px; width:70%" title="@point.Date.ToString("dd MMM yyyy"): @point.Total sign-in(s), @point.Failed failed"></div>
                            <div class="fg-secondary" style="font-size:.65rem">@point.Date.ToString("dd")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-5">
    <div class="lg:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small text-uppercase fw-semibold fg-3">Recent tenants</span>
                    <a asp-action="Index" asp-controller="Tenants" class="small">View all</a>
                </div>
                @if (Model.RecentTenants.Count == 0)
                {
                    <p class="fg-secondary small mb-0">No tenants created yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (RecentTenantItem tenant in Model.RecentTenants)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                                <div>
                                    <a asp-action="Details" asp-controller="Tenants" asp-route-id="@tenant.Id" class="fw-semibold">@tenant.DisplayName</a>
                                    <div class="fg-secondary small">@tenant.ClientId</div>
                                </div>
                                <span class="fg-secondary small">@DateTime.SpecifyKind(tenant.CreatedOn, DateTimeKind.Utc).ToString("dd'-'MM'-'yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="lg:col-6 col-12">
        <div class="card h-100">
            <div class="p-7">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small text-uppercase fw-semibold fg-3">Recent audit events</span>
                    <a asp-action="AuditLogs" asp-controller="SecurityLogs" class="small">View all</a>
                </div>
                @if (Model.RecentAuditEvents.Count == 0)
                {
                    <p class="fg-secondary small mb-0">No audit events recorded yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (RecentAuditItem auditEvent in Model.RecentAuditEvents)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                                <div class="text-truncate me-3">
                                    <span class="badge badge-subtle rounded-pill theme-secondary">@auditEvent.EventType</span>
                                    <span class="small">@auditEvent.Reason</span>
                                    <div class="fg-secondary small text-truncate" style="max-width:280px">@auditEvent.ActorEmail</div>
                                </div>
                                <span class="fg-secondary small text-nowrap">@(DateTime.SpecifyKind(auditEvent.CreatedOn, DateTimeKind.Utc).ToString("dd'-'MM'-'yyyy HH':'mm", System.Globalization.CultureInfo.InvariantCulture)) UTC</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
