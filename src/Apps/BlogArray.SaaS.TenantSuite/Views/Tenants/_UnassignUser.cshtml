@model UnAssignViewModel

@using (Html.AjaxBeginForm(new AjaxOptions
 {
     Url = @Url.ActionLink("Unassign"),
     HttpMethod = "post",
     OnSuccess = "onTenantAssignUnassignChange",
     OnFailure = "handleAjaxError"
 }, new { id = "saveUnassignForm" }))
{
    <dialog class="drawer drawer-end medium" tabindex="-1" id="tenantEditOffcanvas" aria-labelledby="offcanvasRightLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="drawer-header border-bottom">
            <h5 id="offcanvasRightLabel">
                Remove users from @Model.Name
            </h5>
            <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
            <input type="hidden" asp-for="ApplicationId" />
            <div class="list-group list-group-flush">
                @if (Model.Users?.Count() == 0)
                {
                    <div class="p-12 text-center">
                        <i class="state-icon bi bi-inbox"></i>
                        <br />
                        <p class="fg-body fs-xl fw-semibold mb-0">
                            No users assigned to this tenant yet.
                        </p>
                        <p class="lg:col-8 mx-auto fs-md fg-secondary">
                            To give people access, use Invite users.
                        </p>
                    </div>
                }
                else
                {
                    <span class="form-text">
                        Select users to remove
                    </span>
                    @foreach (var user in Model.Users)
                    {
                        <label class="list-group-item d-flex gap-5">
                            <input class="check flex-shrink-0" type="checkbox" value="@user.Id" name="Users" id="@user.Id" style="font-size: 1.375em;">
                            <span class="form-checked-content">
                                <strong>@user.DisplayName</strong>
                                <small class="d-block fg-secondary">
                                    @user.Email
                                </small>
                            </span>
                        </label>
                    }
                }
            </div>
            <div class="form-field mt-5">
                <input class="check" type="checkbox" name="notify" value="true" id="unassignNotify" checked />
                <label hide-indicator="true" for="unassignNotify">Email the users about the removed access</label>
            </div>
            @* Posted when the box is unchecked (checked posts "true" first, which wins). Untick when
               offboarding or responding to a suspected account compromise. *@
            <input type="hidden" name="notify" value="false" />
        </div>
        <div class="drawer-footer border-top">
            <div>
                @if (Model.Users?.Count() > 0)
                {
                    <input type="submit" value="Remove selected users" class="btn btn-solid theme-primary" />
                }
                <input type="button" value="Cancel" class="btn btn-solid theme-secondary" data-bs-dismiss="drawer" aria-label="Close" />
            </div>
        </div>
    </dialog>
}

<script>
    $(document).ready(function () {
        Unobtrusive.reInit($("#saveUnassignForm"));
    });
</script>