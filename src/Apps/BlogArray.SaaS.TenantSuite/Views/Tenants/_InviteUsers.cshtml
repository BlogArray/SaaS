@model InviteUsersViewModel
@using BlogArray.SaaS.Domain.Helpers

@using (Html.AjaxBeginForm(new AjaxOptions
 {
     Url = @Url.ActionLink("Invite"),
     HttpMethod = "post",
     OnSuccess = "onTenantAssignUnassignChange",
     OnFailure = "handleAjaxError"
 }, new { id = "inviteUsersForm" }))
{
    <dialog class="drawer drawer-end medium" tabindex="-1" id="tenantEditOffcanvas" aria-labelledby="inviteUsersLabel" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="drawer-header border-bottom">
            <h5 id="inviteUsersLabel">
                Invite users to @Model.Name
            </h5>
            <button type="button" class="btn-close fg-reset" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
            <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
            <p class="form-text">
                New email addresses get an account and a link to set their password; they have access as soon as they set it up.
                People who already have an account get an invitation, and have access only after they accept it.
            </p>
            <div class="mb-5">
                <label for="inviteEmails" class="form-label">Email addresses</label>
                <input type="text" name="Emails" id="inviteEmails" class="form-control" placeholder="name@example.com" autocomplete="off" />
                <div class="form-text">Press Enter or type a comma after each address. Up to @InviteEmailList.MaxEmails at a time.</div>
            </div>
            <div class="mb-5">
                <label for="inviteDisplayName" class="form-label">Name <span class="fg-secondary">(optional)</span></label>
                <input type="text" name="DisplayName" id="inviteDisplayName" class="form-control" maxlength="256" autocomplete="off" />
                <div class="form-text">Used for a new account when you invite one address. Existing accounts keep their name.</div>
            </div>
            <div class="form-field mt-5">
                <input class="check" type="checkbox" name="Notify" value="true" id="inviteNotify" checked />
                <label hide-indicator="true" for="inviteNotify">Email the invitations</label>
            </div>
            @* Posted when the box is unchecked (checked posts "true" first, which wins). *@
            <input type="hidden" name="Notify" value="false" />
        </div>
        <div class="drawer-footer border-top">
            <div>
                <input type="submit" value="Invite" class="btn btn-solid theme-primary" />
                <input type="button" value="Cancel" class="btn btn-solid theme-secondary" data-bs-dismiss="drawer" aria-label="Close" />
            </div>
        </div>
    </dialog>
}

<script>
    $(document).ready(function () {
        Unobtrusive.reInit($("#inviteUsersForm"));

        new Choices('#inviteEmails', {
            placeholderValue: 'Enter email addresses',
            allowHTML: false,
            allowHtmlUserInput: false,
            editItems: true,
            duplicateItemsAllowed: false,
            maxItemCount: @InviteEmailList.MaxEmails,
            uniqueItemText: 'This address is already in the list',
            customAddItemText: 'Enter a valid email address',
            addItemFilter: function (value) {
                if (!value) {
                    return false;
                }
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                const expression = new RegExp(emailRegex.source, 'i');
                return expression.test(value);
            }
        });
    });
</script>
