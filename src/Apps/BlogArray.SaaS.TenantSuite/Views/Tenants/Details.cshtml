@model ApplicationListViewModel

@{
    string title = $"{Model.DisplayName} ({Model.ClientId})";
    ViewData["Title"] = $"Tenant > {title}";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-1">
            <img height="34" alt="profile icon" class="flex-shrink-0 me-1 rounded" loading="lazy" id="faviconImage" src="@Model.Icon" />
            @title
        </h3>
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb breadcrumb-flush">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="breadcrumb-link">
                        All tenants
                    </a>
                </li>
                <li class="breadcrumb-divider" aria-hidden="true"></li>
                <li class="breadcrumb-item"><span class="breadcrumb-link active" aria-current="page">@title</span></li>
            </ol>
        </nav>
    </div>
    <div class="card-body">
        @Html.DynamicContentLoader("toolbar", Url.Action("Toolbar", "Tenants", new { @id = Model.Id }))
        @Html.DynamicContentLoader("basicInfo", Url.Action("BasicInfo", "Tenants", new { @id = Model.Id }))
        <hr class="my-5">
        @Html.DynamicContentLoader("securityInfo", Url.Action("Security", "Tenants", new { @id = Model.Id }))
        <hr class="my-5">
        @Html.DynamicContentLoader("themeInfo", Url.Action("Theme", "Tenants", new { @id = Model.Id }))
    </div>
</div>

<div id="changeTenantInfo"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    var tenantEditCanvas, newKeysModal;

    function tenantEditFormLoaded() {
        tenantEditCanvas = new bootstrap.Drawer(document.getElementById('tenantEditOffcanvas'));
        tenantEditCanvas.show();
    }

    function onTenantChangeSuccess(e) {
        DynamicContentLoader.load('basicInfo');
        onTenantChange(e);
    }

    function onSecurityChangeSuccess(e) {
        DynamicContentLoader.load('securityInfo');
        onTenantChange(e);
    }

    function onThemeChangeSuccess(e) {
        DynamicContentLoader.load('themeInfo');
        onTenantChange(e);
    }

    function onTenantAssignUnassignChange(e){
        DynamicContentLoader.load('toolbar');
        onTenantChange(e);
    }

    function onTenantChange(e){
        tenantEditCanvas.hide();
        Toast.success(e.message);
    }

    // Pending invitations drawer: "this" is the submitted form.
    function onInvitationResent(e) {
        Toast.success(e.message);
    }

    function onInvitationRevoked(e) {
        const row = this.closest('[data-invitation]');
        if (row) {
            row.remove();
        }
        DynamicContentLoader.load('toolbar');
        Toast.success(e.message);
    }

    function onApiKeyRevoked(e) {
        DynamicContentLoader.load('toolbar');
        Toast.success(e.message);
    }

    function onKeysGenerateSuccess() {
        newKeysModal = new bootstrap.Dialog(document.getElementById('keysModal'));
        newKeysModal.show();
    }

    // The API key prompt is a modal dialog inside #changeTenantInfo, which the result replaces.
    // Close the prompt first and show the result only once it has closed: removing an open
    // dialog skips its close handling (the page would stay scroll-locked).
    function onRotatePromptSuccess(html) {
        const prompt = this.closest('dialog');
        const showResult = function () {
            $('#changeTenantInfo').html(html);
            onKeysGenerateSuccess();
        };

        if (prompt && prompt.open) {
            prompt.addEventListener('hidden.bs.dialog', showResult, { once: true });
            bootstrap.Dialog.getOrCreateInstance(prompt).hide();
        } else {
            showResult();
        }
    }

    function rotatePromptLoaded() {
        let rotatePromptModal = new bootstrap.Dialog(document.getElementById('rotatePromptModal'));
        rotatePromptModal.show();
    }

</script>