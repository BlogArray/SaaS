@model TenantToolbar

<div class="btn-toolbar mb-3" role="toolbar" aria-label="Tenant actions">
    <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Credentials">
        @* Submits the rotate-secret form below via the form attribute, so the button stays a
           direct child of .btn-group (Bootstrap's group sizing, joined corners and dividers
           only apply to direct children). *@
        <button type="submit" form="rotate-secret-form-@Model.Id" class="btn btn-subtle theme-secondary" title="Rotate client secret">Rotate client secret</button>
        @Html.AjaxActionLink("Rotate api key", "RotateApiKeys", "Tenants", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "rotatePromptLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Rotate api key" })
    </div>
    <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Users">
        @Html.AjaxActionLink($"Users ({Model.UsersCount})", "Unassign", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "tenantEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "View all users" })
        @Html.AjaxActionLink("Add users", "Assign", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "tenantEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Add users" })
    </div>
</div>

<form id="rotate-secret-form-@Model.Id" asp-controller="Tenants" asp-action="RotateKeys" method="post" data-ajax="true" data-ajax-method="post" data-ajax-update="#changeTenantInfo" data-ajax-confirm="Rotating the client secret may disrupt access for some applications. Are you sure you want to proceed?" data-ajax-success="onKeysGenerateSuccess" hidden>
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="type" value="secret" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
