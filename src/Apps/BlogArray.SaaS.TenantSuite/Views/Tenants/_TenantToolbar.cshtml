@model TenantToolbar

<div class="btn-toolbar mb-3" role="toolbar" aria-label="Tenant actions">
    <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Credentials">
        @* Both rotations open the same prompt (recipients for the new credential) and then
           show the new value once, with a copy option. *@
        @if (!Model.IsTenantSuite)
        {
            @Html.AjaxActionLink("Rotate client secret", "RotateApiKeys", "Tenants", new { id = Model.Id, type = "secret" }, new AjaxOptions
       {
           UpdateTargetId = "changeTenantInfo",
           OnSuccess = "rotatePromptLoaded"
       }, new { @class = "btn btn-subtle theme-secondary", title = "Rotate client secret" })
        }
        @Html.AjaxActionLink("Rotate api key", "RotateApiKeys", "Tenants", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "rotatePromptLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Rotate api key" })
        @if (Model.HasApiKey)
        {
            @* Submits the hidden form below, so the button stays a direct child of .btn-group. *@
            <button type="submit" form="revoke-api-key-form-@Model.Id" class="btn btn-subtle theme-secondary" title="Revoke the API key without issuing a new one">Revoke api key</button>
        }
    </div>
    @if (Model.HasApiKey)
    {
        <form id="revoke-api-key-form-@Model.Id" asp-controller="Tenants" asp-action="RevokeApiKey" method="post" data-ajax="true" data-ajax-method="post" data-ajax-confirm="Revoke this tenant's API key? Every call with it is rejected immediately, including the tenant app's own (e.g. inviting users), until you rotate to a new key." data-ajax-success="onApiKeyRevoked" hidden>
            <input type="hidden" name="id" value="@Model.Id" />
        </form>
    }
    <div class="btn-group btn-group-sm btn-group-divider" role="group" aria-label="Users">
        @Html.AjaxActionLink($"Users ({Model.UsersCount})", "Unassign", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "tenantEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "View all users" })
        @Html.AjaxActionLink("Invite users", "Invite", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "tenantEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Invite people by email" })
        @Html.AjaxActionLink($"Pending invitations ({Model.PendingInvitationsCount})", "PendingInvitations", new { id = Model.Id }, new AjaxOptions
   {
       UpdateTargetId = "changeTenantInfo",
       OnSuccess = "tenantEditFormLoaded"
   }, new { @class = "btn btn-subtle theme-secondary", title = "Invitations waiting to be accepted" })
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
