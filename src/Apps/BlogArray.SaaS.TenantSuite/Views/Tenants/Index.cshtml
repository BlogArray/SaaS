@model IEnumerable<ApplicationListViewModel>

@{
    ViewData["Title"] = "Tenants";
    string? searchTerm = ViewBag.SearchTerm;
}
<h3>Tenants</h3>
<div class="card">
    <div class="card-header">
        <div class="row gx-3">
            <div class="col">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="term" id="term" value="@searchTerm" class="form-control" placeholder="Search..." aria-label="Search..." aria-describedby="search-addon">
                        <button class="btn btn-outline-secondary" type="submit" id="search-addon">
                            <div class="d-flex">
                                <i class="bi bi-search d-md-none"></i>
                                <span class="d-none d-md-block">Search</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-auto">
                <a asp-action="Create" class="btn btn-primary">
                    <div class="d-flex">
                        <i class="bi bi-building-add"></i>
                        <span class="d-none d-md-block ms-2">Create new</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
    <div class="card-body py-0">
        <div class="list-group list-group-flush">
            @if (Model.Count() == 0)
            {
                <div class="p-5 text-center">
                    @if (searchTerm?.Length > 0)
                    {
                        <i class="state-icon bi bi-search"></i>
                        <br />
                        <p class="text-body-emphasis fs-4 fw-semibold mb-0">
                            No matching results.
                        </p>
                        <p class="col-lg-8 mx-auto fs-6 text-muted">
                            Try adjusting your search or create new one.
                        </p>
                    }
                    else
                    {
                        <i class="state-icon bi bi-inbox"></i>
                        <br />
                        <p class="text-body-emphasis fs-4 fw-semibold mb-0">
                            It looks a bit empty here!
                        </p>
                        <p class="col-lg-8 mx-auto fs-6 text-muted">
                            Start by adding new data or explore other areas.
                        </p>
                    }
                    <div class="d-inline-flex gap-2 mb-5">
                        <a asp-action="Create" class="d-inline-flex align-items-center btn btn-primary px-4 rounded-pill bi bi-plus-lg bi-mr" type="button">
                            Create new tenant
                        </a>
                    </div>
                </div>
            }
            @foreach (var item in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center p-0" aria-current="true">
                    <div class="d-flex gap-3 py-3">
                        <a asp-action="Details" asp-route-id="@item.Id">
                            <img id="headerProfileViewImage" src="@item.Icon" alt="profile image" width="48" height="48" class="flex-shrink-0">
                        </a>
                        <div class="d-flex gap-2 w-100 justify-content-between">
                            <div>
                                <h6 class="mb-0">
                                    <a asp-action="Details" asp-route-id="@item.Id">
                                        @item.DisplayName (@item.ClientId)
                                    </a>
                                </h6>
                                <p class="mb-0 opacity-75 d-inline-block text-truncate" title="@item.Description" style="max-width: 300px;">@item.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@if (Model.Count() > 0)
{
    <div class="mt-2">
        @Html.Pager((IPager)Model, page => Url.Action("Index", "Tenants", new { page, take = ViewBag.Take, term = ViewBag.SearchTerm }), PrePagerOptions.MinimalWithEntriesText)
    </div>
}

@if (TempData["CreatedApiKey"] is string createdApiKey)
{
    string? emailFailed = TempData["EmailFailed"] as string;

    <div class="modal fade" id="createdTenantModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="createdTenantModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="createdTenantModalLabel">Tenant @TempData["CreatedTenantName"] created</h1>
                </div>
                <div class="modal-body">
                    @if (emailFailed != null)
                    {
                        <div class="alert alert-warning py-2">@emailFailed</div>
                    }
                    else
                    {
                        <div class="alert alert-success py-2">The credentials have been emailed to the tenant administrators.</div>
                    }
                    <div class="mb-3">
                        <label for="createdClientSecret" class="form-label">Client Secret</label>
                        <div class="input-group">
                            <input type="text" id="createdClientSecret" class="form-control" value="@TempData["CreatedClientSecret"]" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyCreated('createdClientSecret', 'The client secret has been copied to your clipboard!')">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="createdApiKey" class="form-label">API Key</label>
                        <div class="input-group">
                            <input type="text" id="createdApiKey" class="form-control" value="@createdApiKey" readonly>
                            <button class="btn btn-outline-secondary" type="button" onclick="copyCreated('createdApiKey', 'The api key has been copied to your clipboard!')">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>
                    <small class="form-text text-muted">Please save these securely. They won’t be shown or emailed again.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">I understand and copied the credentials</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            new bootstrap.Modal(document.getElementById('createdTenantModal')).show();
        });

        function copyCreated(elementId, message) {
            ClipboardModule.copyText(elementId, message, 'Failed to copy the value.');
        }
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
