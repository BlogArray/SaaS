@model IEnumerable<BlogArray.SaaS.App.Models.UserVM>

@{
    ViewData["Title"] = "Personnels";
}

<h3>Personnels</h3>

<p>
    <a asp-action="Create">Create new personnel</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Email
            </th>
            <th>
                Active
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        @:Yes
                        <form asp-action="DeActivate" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-link btn-sm px-0 align-baseline">Disable user</button>
                        </form>
                    }
                    else
                    {
                        @:No
                        <form asp-action="Activate" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-link btn-sm px-0 align-baseline">Activate user</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
