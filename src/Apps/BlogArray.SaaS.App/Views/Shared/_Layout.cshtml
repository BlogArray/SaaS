@{
    AppTenantInfo? tenantInfo = Context.GetMultiTenantContext<AppTenantInfo>()?.TenantInfo;
    if (tenantInfo is null)
    {
        tenantInfo = new AppTenantInfo();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_ColorModeHead" />
    <title>@ViewData["Title"] - @tenantInfo.Name</title>
    <link rel="icon" href="@tenantInfo.Favicon">
    <link rel="stylesheet" href="~/_content/BlogArray.SaaS.Resources/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <environment include="Development">
        <link rel="stylesheet" href="~/_content/BlogArray.SaaS.Resources/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/_content/BlogArray.SaaS.Resources/css/site.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <script src="~/_content/BlogArray.SaaS.Resources/lib/jquery/dist/jquery.min.js"></script>

    <div class="app-layout">
    <header class="sticky-top">
        <nav class="navbar sm:navbar-expand app-navbar app-navbar-accent" style="--app-brand-accent: @tenantInfo.PrimaryColor;">
            <div class="container-fluid">
                <a class="navbar-brand" style="font-size:1.5rem" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="@tenantInfo.Logo" alt="Logo" height="30"
                         class="d-inline-block align-text-top">
                    <span class="mx-1 d-none md:d-inline fw-normal">@tenantInfo.Name</span>
                    <div class="vr"></div>
                </a>
                <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer" aria-controls="navbarDrawer"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon" aria-hidden="true"></span>
                </button>
                <dialog class="drawer drawer-end" tabindex="-1" id="navbarDrawer" aria-labelledby="navbarDrawerLabel">
                    <div class="drawer-header">
                        <h5 class="drawer-title" id="navbarDrawerLabel">@tenantInfo.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
                    </div>
                    <div class="drawer-body">
                        <ul class="nav navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link fg-body" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fg-body" asp-area="" asp-controller="Personnels" asp-action="Index">Personnels</a>
                            </li>
                        </ul>
                    </div>
                </dialog>
                <div class="ms-auto text-end d-flex align-items-center gap-1">
                    <partial name="_ColorModeMenu" />
                    @if (User.Identity.IsAuthenticated)
                    {
                        <partial name="_LoginPartial" />
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="app-body container h-main-app-body">
        <partial name="_AlertPartial" />
        @RenderBody()
    </main>

    <footer class="py-5 px-5 text-center small fg-3">
        © @DateTime.Now.Year <a href="@tenantInfo.Website" rel="external" target="_blank" class="fg-2">@tenantInfo.Legalname</a>
    </footer>
    </div>

    <div id="toastContainer" aria-live="polite" aria-atomic="true" class="toast-container position-fixed top-0 end-0 p-5"></div>

    <script type="module" src="~/_content/BlogArray.SaaS.Resources/js/bootstrap-global.js" asp-append-version="true"></script>
    <environment include="Development">
        <script src="~/_content/BlogArray.SaaS.Resources/js/site.js" asp-append-version="true"></script>
        @* <script src="~/js/themer.js" asp-append-version="true"></script> *@
    </environment>
    <environment exclude="Development">
        <script src="~/_content/BlogArray.SaaS.Resources/js/site.min.js" asp-append-version="true"></script>
        @* <script src="~/js/themer.min.js" asp-append-version="true"></script> *@
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
