@using Microsoft.AspNetCore.Identity
@using System.Security.Claims

@{
    string givenName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? User.Identity?.Name;
    string email = User.FindFirst(ClaimTypes.Email).Value;
    string profileIcon = User.FindFirst("image").Value;
}
<div class="d-flex">
    @if (User.Identity.IsAuthenticated)
    {
        <div class="nav-item">
            <button class="nav-link btn btn-sm p-0 m-0" role="button" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false">
                <img height="32" width="32" class="rounded-circle" id="headerProfileImage" alt="profile icon" loading="lazy" src="@profileIcon" />
            </button>
            <div class="menu shadow">
                <a target="_blank" rel="external" asp-controller="Authentication" asp-action="Manage" class="menu-item d-flex gap-5 py-5" aria-current="true">
                    <img id="headerProfileViewImage" src="@profileIcon" alt="profile image" width="48" height="48" class="rounded-circle flex-shrink-0">
                    <div class="d-flex gap-3 w-100 justify-content-between">
                        <div>
                            <h6 class="mb-0">@givenName</h6>
                            <p class="mb-0 opacity-75">@email</p>
                        </div>
                    </div>
                </a>
                <hr class="menu-divider">
                <a class="menu-item gap-3 py-3 px-5 lh-sm" target="_blank" rel="external" asp-controller="Authentication" asp-action="Manage">
                    <i class="bi bi-person"></i>
                    Profile
                    <i class="bi bi-box-arrow-up-right float-end"></i>
                </a>
                <hr class="menu-divider">
                <form asp-controller="Authentication" asp-action="LogOut" method="post">
                    <button type="submit" class="menu-item gap-3 py-3 px-5 lh-sm border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link fg-body" asp-controller="Authentication" asp-action="LogIn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Login
                </a>
            </li>
        </ul>
    }
</div>