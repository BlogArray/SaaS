@page
@model ForgotMfaModel
@{
    ViewData["Title"] = "Lost your authenticator?";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}
<form method="post">
    <h6 class="text-center mb-3">
        Lost your authenticator?
    </h6>
    <p class="form-text mb-3">
        Signed in as <span class="fw-semibold">@Model.PendingUser.Email</span>. We will email
        a reset link to this address. Opening it resets multi-factor authentication for this
        account; you will then sign in with your password and set up your authenticator again.
    </p>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    @if (Model.CaptchaEnabled)
    {
        <div class="cf-turnstile mb-3"
             data-sitekey="@Model.CaptchaSiteKey"
             data-response-field-name="CaptchaToken"
             data-theme="light">
        </div>
        <span asp-validation-for="CaptchaToken" class="text-danger"></span>
    }
    <button type="submit" class="w-100 btn btn-primary">Email me a reset link</button>
</form>

<div class="text-center mt-3">
    <p>
        <a asp-page="./Login">Go back to login</a>
    </p>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CaptchaEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    }
}
