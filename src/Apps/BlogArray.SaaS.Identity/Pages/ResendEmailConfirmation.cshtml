@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<h6 class="text-center mb-3">
    Resend email confirmation
</h6>
<form method="post">
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="Enter your email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    @if (Model.CaptchaEnabled)
    {
        <div class="cf-turnstile mb-3"
             data-sitekey="@Model.CaptchaSiteKey"
             data-response-field-name="Input.CaptchaToken"
             data-theme="light">
        </div>
        <span asp-validation-for="Input.CaptchaToken" class="text-danger"></span>
    }
    <button type="submit" class="w-100 btn btn-primary">Resend</button>
</form>

<div class="text-center mt-3">
    <p>
        <a asp-page="./Login">Go back to login</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CaptchaEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    }
}
