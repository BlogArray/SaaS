@page
@model LoginWithPasskeyModel
@{
    ViewData["Title"] = "Sign in with your passkey";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<h6 class="text-center mb-5">
    Sign in with your passkey
</h6>

<div asp-validation-summary="ModelOnly" class="fg-danger" role="alert"></div>

<div class="alert theme-secondary" role="alert" id="passkeyMessage" style="display:none"></div>

<form id="passkey-form" method="post">
    <input type="hidden" asp-for="Input.Response" />
    <input type="hidden" asp-for="Next" />
    <input type="hidden" asp-for="AssertionOptions" />
    <input type="hidden" asp-for="CeremonyId" />
    <button type="button" class="w-100 btn btn-solid theme-primary" id="usePasskey">
        <i class="bi bi-fingerprint me-1"></i> Use passkey
    </button>
    <div class="text-center mt-5">
        <a asp-page="./LoginWithPassword" asp-route-next="@Model.Next">Use your password instead</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkey.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';

            const passkey = window.blogArrayPasskey;

            function showMessage(text) {
                const message = document.getElementById('passkeyMessage');
                message.textContent = text;
                message.style.display = '';
            }

            async function runAssertion() {
                // No allowCredentials: the browser/OS shows the account chooser with every saved
                // passkey for this site.
                document.getElementById('Input_Response').value =
                    await passkey.getAssertion(document.querySelector('input[name="AssertionOptions"]').value);

                document.getElementById('passkey-form').submit();
            }

            function run() {
                runAssertion().catch(function (error) {
                    if (!passkey.isCancellation(error)) {
                        showMessage('The passkey could not be used: ' + error.message);
                    }
                });
            }

            document.getElementById('usePasskey').addEventListener('click', run);

            // Offer the ceremony automatically on page load.
            window.addEventListener('load', function () {
                if (passkey && passkey.isSupported) {
                    run();
                }
            });
        })();
    </script>
}
