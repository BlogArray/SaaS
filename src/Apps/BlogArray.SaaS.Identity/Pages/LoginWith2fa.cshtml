@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<h6 class="text-center mb-5">Continue with two-factor authentication</h6>

<partial name="_StatusMessage" for="StatusMessage" />

<span class="d-block text-center mb-5">
    <i class="state-icon fg-primary bi bi-shield-lock"></i>
</span>

<p>Your account is protected with two-factor authentication. Enter the code from your authenticator app below to continue.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="fg-danger" role="alert"></div>
    <div class="mb-5">
        <label asp-for="Input.TwoFactorCode" class="form-label"></label>
        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="Enter verification code" />
        <span asp-validation-for="Input.TwoFactorCode" class="fg-danger"></span>
    </div>
    <div class="mb-5 form-field">
        <input class="check" asp-for="Input.RememberMachine" />
        <label asp-for="Input.RememberMachine">
            @Html.DisplayNameFor(m => m.Input.RememberMachine)
        </label>
    </div>
    <button type="submit" class="w-100 btn btn-solid theme-primary">Log in</button>
</form>

<div class="text-center mt-5">
    <p>
        <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-next="@Model.Next">Log in with a recovery code</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
