@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<section>
    <form id="account" method="post">
        <h6 class="text-center mb-5">
            Enter your email to continue
        </h6>
        <div asp-validation-summary="ModelOnly" class="fg-danger" role="alert"></div>
        <div class="mb-5">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="fg-danger"></span>
        </div>

        <p class="small fg-secondary">
            By clicking "Next", you agree to BlogArray <a href="https://help.blogarray.com/docs/site-policy/terms-of-use/" target="_blank">Terms of use</a> and <a href="https://help.blogarray.com/docs/site-policy/privacy-policy/" target="_blank">Privacy Policy</a>.
        </p>
        <button id="login-submit" type="submit" class="w-100 btn btn-solid theme-primary">Next</button>

        <div class="d-flex align-items-center my-5">
            <hr class="flex-grow-1">
            <span class="small fg-secondary px-3">or</span>
            <hr class="flex-grow-1">
        </div>

        <a id="passkey-signin" asp-page="./LoginWithPasskey" asp-route-next="@Model.Next"
           class="w-100 btn btn-outline theme-primary" style="display:none;">
            <i class="bi bi-fingerprint me-1"></i> Sign in with a passkey
        </a>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the passkey option only where the WebAuthn API is available.
        if (window.PublicKeyCredential) {
            document.getElementById('passkey-signin').style.display = '';
        }
    </script>
}
