@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<section>
    <form id="account" method="post">
        <h6 class="text-center mb-5">
            Enter your email to continue
        </h6>
        <div asp-validation-summary="ModelOnly" class="fg-danger" role="alert"></div>
        <div class="mb-5">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username webauthn" aria-required="true" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="fg-danger"></span>
        </div>

        <p class="small fg-secondary">
            By clicking "Next", you agree to BlogArray <a href="https://help.blogarray.com/docs/site-policy/terms-of-use/" target="_blank">Terms of use</a> and <a href="https://help.blogarray.com/docs/site-policy/privacy-policy/" target="_blank">Privacy Policy</a>.
        </p>
        <button id="login-submit" type="submit" class="w-100 btn btn-solid theme-primary">Next</button>

        <div class="d-flex align-items-center my-5">
            <hr class="flex-grow-1">
            <span class="small fg-secondary px-3">or</span>
            <hr class="flex-grow-1">
        </div>

        <button type="button" id="passkey-signin" class="w-100 btn btn-outline theme-primary" style="display:none;">
            <i class="bi bi-fingerprint me-1"></i> Sign in with a passkey
        </button>
        <div class="fg-danger mt-3" role="alert" id="passkey-message" style="display:none;"></div>
    </form>

    @* Passkey sign-in runs here; the result is verified by LoginWithPasskey, which also shows
       any error. The challenge is server-held: only its ceremony id travels with the form. *@
    <form id="passkey-form" method="post" asp-page="./LoginWithPasskey">
        <input type="hidden" name="Next" value="@Model.Next" />
        <input type="hidden" name="CeremonyId" id="passkey-ceremony" />
        <input type="hidden" name="Input.Response" id="passkey-response" />
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkey.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';

            const passkey = window.blogArrayPasskey;

            if (!passkey || !passkey.isSupported) {
                return;
            }

            const button = document.getElementById('passkey-signin');
            const message = document.getElementById('passkey-message');

            // The email field's autofill request, cancelled when the button starts the modal one.
            let autofill = null;

            // One server-held challenge per page, fetched only when a passkey is actually offered
            // (the button, or autofill). It stays usable until a sign-in consumes it.
            let ceremony = null;

            async function getCeremony() {
                if (!ceremony) {
                    const response = await fetch('@Url.Page("./Login", "PasskeyOptions")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('#account input[name="__RequestVerificationToken"]').value }
                    });

                    if (!response.ok) {
                        throw new Error(response.status === 429 ? 'Too many attempts. Please wait a minute and try again.' : 'The passkey option is unavailable right now.');
                    }

                    ceremony = await response.json();
                }

                return ceremony;
            }

            function submit(response) {
                document.getElementById('passkey-ceremony').value = ceremony.ceremonyId;
                document.getElementById('passkey-response').value = response;
                document.getElementById('passkey-form').submit();
            }

            button.style.display = '';

            button.addEventListener('click', async function () {
                message.style.display = 'none';

                if (autofill) {
                    autofill.abort();
                    autofill = null;
                }

                try {
                    const { options } = await getCeremony();
                    submit(await passkey.getAssertion(options));
                } catch (error) {
                    if (!passkey.isCancellation(error)) {
                        message.textContent = 'The passkey could not be used: ' + error.message;
                        message.style.display = '';
                    }
                }
            });

            // Offer saved passkeys in the email field's autofill where the browser supports it:
            // choosing one signs in straight away. Dismissing it does nothing.
            passkey.isConditionalMediationAvailable().then(async function (available) {
                if (!available) {
                    return;
                }

                autofill = new AbortController();

                try {
                    const { options } = await getCeremony();
                    submit(await passkey.getAssertion(options, 'conditional', autofill.signal));
                } catch (error) {
                    // Cancelled by the button, or not completed: the page stays as it is.
                }
            });
        })();
    </script>
}
