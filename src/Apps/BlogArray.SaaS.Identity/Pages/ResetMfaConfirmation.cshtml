@page
@{
    ViewData["Title"] = "Multi-factor reset";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<h6 class="text-center mb-3">
    Multi-factor authentication reset
</h6>
<div class="alert alert-success mb-3" role="alert">
    <p class="mb-0">
        Your authenticator app has been reset. Sign in with your password and follow the
        prompts to set up your authenticator again.
    </p>
</div>
<div class="alert alert-warning mb-0" role="alert">
    <p class="mb-0">
        If you did not request this reset, your email account may be compromised - contact
        support immediately.
    </p>
</div>

<div class="text-center mt-3">
    <p>
        <a asp-page="./Login">Go back to login</a>
    </p>
</div>
