@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}
<form method="post">
    <h6 class="text-center mb-5">
        Forgot your password?
    </h6>
    <div asp-validation-summary="ModelOnly" class="fg-danger" role="alert"></div>
    <div class="mb-5">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email" />
        <span asp-validation-for="Input.Email" class="fg-danger"></span>
    </div>
    @if (Model.CaptchaEnabled)
    {
        <div class="cf-turnstile mb-5"
             data-sitekey="@Model.CaptchaSiteKey"
             data-response-field-name="Input.CaptchaToken"
             data-theme="light">
        </div>
        <span asp-validation-for="Input.CaptchaToken" class="fg-danger"></span>
    }
    <button type="submit" class="w-100 btn btn-solid theme-primary">Reset Password</button>
</form>

<div class="text-center mt-5">
    <p>
        <a asp-page="./Login">Go back to login</a>
    </p>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CaptchaEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    }
}
