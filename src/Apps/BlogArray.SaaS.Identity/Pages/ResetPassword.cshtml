@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<h6 class="text-center mb-3">
    Reset your password
</h6>
@if (Model.IsTemporaryPasswordSignIn)
{
    <div class="alert alert-warning mb-3" role="alert">
        You signed in using a temporary password. Please set a new password to continue.
    </div>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <input type="hidden" asp-for="IsTemporaryPasswordSignIn" />
    @if (Model.CaptchaEnabled)
    {
        <div class="cf-turnstile mb-3"
             data-sitekey="@Model.CaptchaSiteKey"
             data-response-field-name="Input.CaptchaToken"
             data-theme="light">
        </div>
        <span asp-validation-for="Input.CaptchaToken" class="text-danger"></span>
    }
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email" readonly="@Model.IsTemporaryPasswordSignIn" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="w-100 btn btn-primary">Reset</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CaptchaEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    }
}
