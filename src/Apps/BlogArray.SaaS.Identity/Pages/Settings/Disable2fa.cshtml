@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable two-factor authentication (2FA)";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Disable two-factor authentication (2FA)</h3>
    </div>
    <div class="card-body">
        <div class="alert theme-warning" role="alert">
            <vstack>
                <p>
                    <strong>This action disables 2FA.</strong>
                </p>
                <p>
                    By disabling Two-factor Authentication (2FA), your account will be no longer protected by a second login step.
                </p>
            </vstack>
        </div>

        <form method="post">
            <button class="btn btn-solid theme-primary" type="submit">Disable 2FA</button>
        </form>
    </div>
</div>