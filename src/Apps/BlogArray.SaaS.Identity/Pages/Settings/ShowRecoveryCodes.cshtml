@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Recovery codes</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning" role="alert">
            <p>
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Put these codes in a safe place.</strong>
            </p>
            <p>
                Emergency recovery codes can be utilized to log into your account in cases where your device is lost, and two-factor authentication codes cannot be received. If you lose your device and don't have the recovery codes you will lose access to your account.
            </p>
            <p>
                When you generate new emergency recovery codes, it is essential to download or copy the new codes.
                <strong>Your old codes will no longer work.</strong>
            </p>
        </div>
        <div class="row">
            <div class="col-md-12">
                @for (var row = 0; row < Model.RecoveryCodes.Length; row++)
                {
                    <code class="recovery-code">@Model.RecoveryCodes[row]</code>
                    <br />
                }
            </div>
        </div>

        <div class="text-center mt-3">
            <p>
                <button type="button" class="btn btn-primary" id="downloadRecoveryCodes">
                    Download Recovery Codes
                </button>
                @if (Url.IsLocalUrl(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="btn btn-primary ms-3">Continue</a>
                }
            </p>
        </div>
    </div>
</div>
<script>
    document.getElementById('downloadRecoveryCodes').addEventListener('click', function() {
        const codes = Array.from(document.querySelectorAll('.recovery-code'))
            .map(x => x.textContent.trim())
            .filter(Boolean);

        if (!codes.length) {
            return;
        }

        const content = [
            'BlogArray MFA Recovery Codes',
            '============================',
            'Keep these codes in a secure location. Each recovery code can only be used once.',
            '',
            ...codes,
            '',
            'Do not share these codes with anyone.'
        ].join('\r\n');

        const blob = new Blob([content], {
            type: 'text/plain;charset=utf-8'
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = 'mfa-recovery-codes.txt';

        link.click();

        URL.revokeObjectURL(url);
    });
</script>