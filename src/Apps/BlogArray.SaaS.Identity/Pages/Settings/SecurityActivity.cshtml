@page
@model SecurityActivityModel
@{
    ViewData["Title"] = "Sign-in activity";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Sign-in activity</h3>
        <p class="mb-0 form-text">
            Authentication attempts on your account. Unrecognised activity? Change your
            password and review your two-factor settings.
        </p>
    </div>
    <div class="card-body py-0">
        @if (Model.Events.Count() == 0)
        {
            <div class="alert alert-secondary mb-0 m-3">
                <p class="mb-0"><i class="bi bi-shield-check"></i> No sign-in activity has been recorded for your account yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="min-width:220px">Event</th>
                            <th style="min-width:110px">Result</th>
                            <th style="min-width:120px">IP address</th>
                            <th style="min-width:170px">Device</th>
                            <th style="min-width:150px">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SignInEvent signInEvent in Model.Events)
                        {
                            bool failed = signInEvent.Result == "Failure";
                            <tr>
                                <td class="text-wrap">@Model.Describe(signInEvent)</td>
                                <td>
                                    <span class="badge rounded-pill text-bg-@(failed ? "danger" : "success")">
                                        @Model.ResultText(signInEvent)
                                    </span>
                                </td>
                                <td class="text-muted small">@(signInEvent.IpAddress ?? "-")</td>
                                <td class="text-muted small text-truncate" style="max-width:170px" title="@signInEvent.DeviceInfo">@(signInEvent.DeviceInfo ?? "-")</td>
                                <td class="text-muted small" title="@signInEvent.CreatedOn.ToUniversalTime().ToString("O")">@signInEvent.CreatedOn.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.Events.Count() > 0)
{
    <div class="mt-2">
        @Html.Pager((IPager)Model.Events, page => Url.Page("/Settings/SecurityActivity", new { page }), PrePagerOptions.MinimalWithEntriesText)
    </div>
}
