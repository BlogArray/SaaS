@page
@model SecurityActivityModel
@{
    ViewData["Title"] = "Recent security activity";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Recent security activity</h3>
        <p class="mb-0 form-text">
            The most recent security events recorded for your account (sign-ins, password and
            two-factor changes). Unrecognised activity? Change your password and review your
            two-factor settings.
        </p>
    </div>
    <div class="card-body">
        @if (Model.Events.Count == 0)
        {
            <div class="alert alert-secondary mb-0">
                <p class="mb-0"><i class="bi bi-shield-check"></i> No security activity has been recorded for your account yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Event</th>
                            <th scope="col">IP address</th>
                            <th scope="col">Browser / device</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (SecurityActivityModel.ActivityEntry entry in Model.Events)
                        {
                            <tr>
                                <td title="@entry.CreatedOn.ToUniversalTime().ToString("O")">@entry.CreatedOn.ToLocalTime().ToString("g")</td>
                                <td class="text-wrap">@entry.Description</td>
                                <td>@(entry.IpAddress ?? "-")</td>
                                <td class="text-wrap"><small class="text-muted">@(entry.UserAgent ?? "-")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
