@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject SignInManagerExtension<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string givenName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? User.Identity?.Name;
    string email = User.FindFirst(ClaimTypes.Email).Value;
    string profileIcon = User.FindFirst("Icon").Value;
    bool isAdmin = User.IsInRole("Superuser");
}
<div class="d-flex">
    @if (SignInManager.IsSignedIn(User))
    {
        if (isAdmin)
        {
            <div class="me-3">
                <button class="btn" role="button" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false">
                    <div class="d-flex">
                        <i class="bi bi-gear"></i>
                    </div>
                </button>
                <div class="menu shadow" style="min-width:250px">
                    <a asp-controller="Authorization" target="_blank" asp-action="Suite" class="menu-item d-flex align-items-start py-3 text-start">
                        <i class="bi bi-building-gear h2 me-3"></i>
                        <div>
                            <i class="bi bi-box-arrow-up-right float-end"></i>
                            <p class="mb-0">Manage tenants</p>
                            <small class="form-text">Manage the tenants, users, roles and scopes</small>
                        </div>
                    </a>
                    <a asp-controller="Settings" asp-action="Index" class="menu-item d-flex align-items-start py-3 text-start">
                        <i class="bi bi-person h2 me-3"></i>
                        <div>
                            <p class="mb-0">BlogArray Account Settings</p>
                            <small class="form-text">Manage your profile information, security and others.</small>
                        </div>
                    </a>
                </div>
            </div>
        }
        <div class="nav-item">
            <button class="nav-link btn btn-sm p-0 m-0" href="#" role="button" data-bs-toggle="menu" data-bs-placement="bottom-end" aria-expanded="false">
                <img height="32" width="32" class="rounded-circle" alt="profile icon" id="headerProfileImage" loading="lazy" src="@profileIcon" />
            </button>
            <div class="menu shadow">
                <a asp-controller="Settings" asp-action="Index" class="menu-item d-flex gap-5 py-5" aria-current="true">
                    <img id="headerProfileViewImage" src="@profileIcon" alt="profile image" width="48" height="48" class="rounded-circle flex-shrink-0">
                    <div class="d-flex gap-3 w-100 justify-content-between">
                        <div>
                            <h6 class="mb-0">@givenName</h6>
                            <p class="mb-0 opacity-75">@email</p>
                        </div>
                    </div>
                </a>
                <hr class="menu-divider">
                <a class="menu-item gap-3 py-3 px-5 lh-sm" active-route asp-controller="Settings" asp-action="Index">
                    <i class="bi bi-person"></i>
                    Profile
                </a>
                <a class="menu-item gap-3 py-3 px-5 lh-sm @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="/settings/linkedaccounts">
                    <i class="bi bi-link-45deg"></i>
                    Linked Accounts
                </a>
                @*
                <a class="menu-item gap-3 py-3 px-5 lh-sm" active-route asp-controller="Settings" asp-action="Email">
                    <i class="bi bi-envelope"></i>
                    Email
                </a>
                *@
                <a class="menu-item gap-3 py-3 px-5 lh-sm  @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" active-route asp-controller="Settings" asp-action="Security">
                    <i class="bi bi-shield-check"></i>
                    Security
                </a>
                <hr class="menu-divider">
                <a class="menu-item gap-3 py-3 px-5 lh-sm" asp-page="/Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </a>
            </div>
        </div>
    }
    else
    {
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link fg-body" asp-page="/Login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Login
                </a>
            </li>
        </ul>
    }
</div>