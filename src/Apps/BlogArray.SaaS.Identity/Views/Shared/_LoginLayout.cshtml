@{
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}
<div class="login-body d-flex align-items-center justify-content-center px-5 py-9">
    <div class="w-100" style="max-width: 26rem;">
        <div class="login-card p-7 md:p-9">
            <div class="mb-7 text-center">
                <img src="~/_content/BlogArray.SaaS.Resources/resources/images/blogarray-full-logo.png" alt="BlogArray" height="35" />
            </div>
            @RenderBody()
        </div>
        <p class="small fg-3 text-center mt-7 mb-0">
            <a href="https://help.blogarray.com/docs/site-policy/privacy-policy/" target="_blank" class="fg-2">Privacy Policy</a>
            <span class="mx-2" aria-hidden="true">·</span>
            <a href="https://help.blogarray.com/docs/site-policy/terms-of-use/" target="_blank" class="fg-2">Terms of use</a>
        </p>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</div>
