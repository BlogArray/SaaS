@{
    ViewData["Title"] = "Password";
    Layout = "~/Views/Shared/_SettingsLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Password</h3>
        <p class="mb-0 form-text">
            Change the password you use to sign in.
        </p>
    </div>
    <div class="card-body">
        <div id="password-form">
            <partial name="Password.cshtml" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Called by the form after a successful change: shows a fresh, empty form.
        function loadPwdForm() {
            $("#password-form").load('@Url.Action("Password", "Settings")');
        }
    </script>
}
