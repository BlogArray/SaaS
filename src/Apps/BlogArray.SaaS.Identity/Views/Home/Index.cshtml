@{
    ViewData["Title"] = "Home";
}

@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<main class="app-main min-vh-100 d-flex flex-column" id="app-main">

    @if (isAuthenticated)
    {
        var authenticationResult = await Context.AuthenticateAsync();
        var principal = authenticationResult.Principal;
        var identity = principal?.Identity;

        var issued = authenticationResult.Properties?.Items.TryGetValue(".issued", out var issuedValue) == true
            ? issuedValue
            : "N/A";

        var expires = authenticationResult.Properties?.Items.TryGetValue(".expires", out var expiresValue) == true
            ? expiresValue
            : "N/A";

        var displayName = User.Identity?.Name
            ?? User.FindFirst(ClaimTypes.Name)?.Value
            ?? User.FindFirst("name")?.Value
            ?? "User";

        var email = User.FindFirst(ClaimTypes.Email)?.Value
            ?? User.FindFirst("email")?.Value;

        var claims = principal?.Claims.ToList() ?? [];

        <!-- Header -->
        <header class="border-bottom bg-white">
            <div class="container-fluid px-4 px-lg-5 py-3">
                <div class="d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center">
                        <div class="bg-dark text-white rounded-3 d-flex align-items-center justify-content-center me-3"
                             style="width:42px;height:42px;">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">Authentication</div>
                            <div class="text-muted small">Account overview</div>
                        </div>
                    </div>

                    <a class="btn btn-outline-dark btn-sm px-3"
                       asp-controller="Account"
                       asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Sign out
                    </a>

                </div>
            </div>
        </header>

        <!-- Main content -->
        <section class="flex-grow-1 bg-light">
            <div class="container-fluid px-4 px-lg-5 py-4 py-lg-5">

                <!-- Welcome -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge rounded-pill text-bg-success px-3 py-2">
                            <i class="bi bi-circle-fill me-1" style="font-size:6px;"></i>
                            Authenticated
                        </span>
                    </div>

                    <h1 class="display-6 fw-semibold mb-1">
                        Welcome, @displayName
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <p class="text-muted mb-0">
                            @email
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Your authentication session is active.
                        </p>
                    }
                </div>

                <!-- Overview cards -->
                <div class="row g-3 mb-4">

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small mb-2">
                                            Account
                                        </div>
                                        <div class="fw-semibold text-truncate"
                                             title="@displayName">
                                            @displayName
                                        </div>
                                    </div>

                                    <div class="bg-light rounded-3 p-2">
                                        <i class="bi bi-person fs-5"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small mb-2">
                                            Authentication
                                        </div>
                                        <div class="fw-semibold">
                                            @(identity?.AuthenticationType ?? "Unknown")
                                        </div>
                                    </div>

                                    <div class="bg-light rounded-3 p-2">
                                        <i class="bi bi-shield-lock fs-5"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small mb-2">
                                            Claims
                                        </div>
                                        <div class="fw-semibold">
                                            @claims.Count
                                        </div>
                                    </div>

                                    <div class="bg-light rounded-3 p-2">
                                        <i class="bi bi-list-check fs-5"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="text-muted small mb-2">
                                            Session
                                        </div>
                                        <div class="fw-semibold text-success">
                                            Active
                                        </div>
                                    </div>

                                    <div class="bg-light rounded-3 p-2">
                                        <i class="bi bi-clock-history fs-5"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row g-4">

                    <!-- Session -->
                    <div class="col-12 col-lg-5">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-header bg-white border-0 px-4 pt-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-dark text-white rounded-3 p-2 me-3">
                                        <i class="bi bi-clock"></i>
                                    </div>

                                    <div>
                                        <h2 class="h5 mb-1">
                                            Session
                                        </h2>
                                        <p class="text-muted small mb-0">
                                            Authentication lifetime
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body px-4 pb-4">

                                <div class="py-3 border-bottom">
                                    <div class="text-muted small mb-1">
                                        Issued
                                    </div>

                                    <div class="fw-medium text-break">
                                        @issued
                                    </div>
                                </div>

                                <div class="py-3">
                                    <div class="text-muted small mb-1">
                                        Expires
                                    </div>

                                    <div class="fw-medium text-break">
                                        @expires
                                    </div>
                                </div>

                                <div class="alert alert-light border mt-2 mb-0">
                                    <div class="d-flex">
                                        <i class="bi bi-info-circle me-2 mt-1"></i>
                                        <div class="small">
                                            This session is managed by the application's
                                            authentication middleware.
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Identity -->
                    <div class="col-12 col-lg-7">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-header bg-white border-0 px-4 pt-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-dark text-white rounded-3 p-2 me-3">
                                        <i class="bi bi-person-badge"></i>
                                    </div>

                                    <div>
                                        <h2 class="h5 mb-1">
                                            Identity
                                        </h2>
                                        <p class="text-muted small mb-0">
                                            Current authenticated identity
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body px-4 pb-4">

                                <div class="row g-3">

                                    <div class="col-sm-6">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                Name
                                            </div>

                                            <div class="fw-semibold text-break">
                                                @displayName
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                Authentication Type
                                            </div>

                                            <div class="fw-semibold text-break">
                                                @(identity?.AuthenticationType ?? "Unknown")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                Is Authenticated
                                            </div>

                                            <div class="fw-semibold text-success">
                                                Yes
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-sm-6">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="text-muted small mb-1">
                                                Claims
                                            </div>

                                            <div class="fw-semibold">
                                                @claims.Count
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Claims -->
                    <div class="col-12">

                        <div class="card border-0 shadow-sm">

                            <div class="card-header bg-white border-0 px-4 pt-4">
                                <div class="d-flex flex-column flex-md-row
                                    justify-content-between align-items-md-center gap-2">

                                    <div class="d-flex align-items-center">
                                        <div class="bg-dark text-white rounded-3 p-2 me-3">
                                            <i class="bi bi-key"></i>
                                        </div>

                                        <div>
                                            <h2 class="h5 mb-1">
                                                Claims
                                            </h2>

                                            <p class="text-muted small mb-0">
                                                Claims received from the identity provider.
                                            </p>
                                        </div>
                                    </div>

                                    <span class="badge rounded-pill text-bg-light px-3 py-2">
                                        @claims.Count total
                                    </span>

                                </div>
                            </div>

                            <div class="card-body p-4">

                                @if (claims.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">

                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width:35%;">
                                                        Type
                                                    </th>
                                                    <th>
                                                        Value
                                                    </th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var claim in claims)
                                                {
                                                    <tr>
                                                        <td>
                                                            <code class="small">
                                                                @claim.Type
                                                            </code>
                                                        </td>

                                                        <td class="text-break">
                                                            @claim.Value
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                        <div class="fw-medium">
                                            No claims available
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </section>
    }
    else
    {
        <!-- Signed out -->
        <section class="flex-grow-1 d-flex align-items-center justify-content-center bg-light px-3">

            <div class="card border-0 shadow-sm text-center"
                 style="max-width:460px;width:100%;">

                <div class="card-body p-5">

                    <div class="bg-dark text-white rounded-circle
                        d-inline-flex align-items-center justify-content-center mb-4"
                         style="width:76px;height:76px;">
                        <i class="bi bi-person-lock fs-2"></i>
                    </div>

                    <h1 class="h3 fw-semibold mb-2">
                        Sign in to continue
                    </h1>

                    <p class="text-muted mb-4">
                        You are currently signed out.
                        Sign in to access your account.
                    </p>

                    <a class="btn btn-dark px-4 py-2"
                       asp-controller="Account"
                       asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Sign in
                    </a>

                </div>

            </div>

        </section>
    }

    <!-- Footer -->
    <footer class="bg-white border-top py-3">
        <div class="container-fluid px-4 px-lg-5">
            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-center gap-2">

                <span class="text-muted small">
                    © @DateTime.Now.Year BlogArray
                </span>

                <a href="https://blogarray.net/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-decoration-none text-muted small">
                    Crafted by Team BlogArray
                </a>

            </div>
        </div>
    </footer>

</main>