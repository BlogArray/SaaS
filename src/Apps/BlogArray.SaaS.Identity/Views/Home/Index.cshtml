@{
    ViewData["Title"] = "Home";
}

@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<main class="app-main min-vh-100 d-flex flex-column" id="app-main">

    @if (isAuthenticated)
    {
        var authenticationResult = await Context.AuthenticateAsync();
        var principal = authenticationResult.Principal;
        var identity = principal?.Identity;

        var issued = authenticationResult.Properties?.Items.TryGetValue(".issued", out var issuedValue) == true
            ? issuedValue
            : "N/A";

        var expires = authenticationResult.Properties?.Items.TryGetValue(".expires", out var expiresValue) == true
            ? expiresValue
            : "N/A";

        var displayName = User.Identity?.Name
            ?? User.FindFirst(ClaimTypes.Name)?.Value
            ?? User.FindFirst("name")?.Value
            ?? "User";

        var email = User.FindFirst(ClaimTypes.Email)?.Value
            ?? User.FindFirst("email")?.Value;

        var claims = principal?.Claims.ToList() ?? [];

        <!-- Header -->
        <header class="border-bottom bg-body">
            <div class="container-fluid px-7 lg:px-12 py-5">
                <div class="d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center">
                        <div class="bg-inverse fg-contrast-inverse rounded-5 d-flex align-items-center justify-content-center me-5"
                             style="width:42px;height:42px;">
                            <i class="bi bi-shield-check fs-lg"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">Authentication</div>
                            <div class="fg-secondary small">Account overview</div>
                        </div>
                    </div>

                    <a class="btn btn-outline theme-inverse btn-sm px-5"
                       asp-controller="Account"
                       asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Sign out
                    </a>

                </div>
            </div>
        </header>

        <!-- Main content -->
        <section class="flex-grow-1">
            <div class="container-fluid px-7 lg:px-12 py-7 lg:py-12">

                <!-- Welcome -->
                <div class="mb-7">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="badge badge-subtle rounded-pill theme-success px-5 py-3">
                            <i class="bi bi-circle-fill me-1" style="font-size:6px;"></i>
                            Authenticated
                        </span>
                    </div>

                    <h1 class="fs-3xl fw-semibold mb-1">
                        Welcome, @displayName
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <p class="fg-secondary mb-0">
                            @email
                        </p>
                    }
                    else
                    {
                        <p class="fg-secondary mb-0">
                            Your authentication session is active.
                        </p>
                    }
                </div>

                <!-- Overview cards -->
                <div class="row g-5 mb-7">

                    <div class="col-12 md:col-6 xl:col-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-7">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fg-secondary small mb-3">
                                            Account
                                        </div>
                                        <div class="fw-semibold text-truncate"
                                             title="@displayName">
                                            @displayName
                                        </div>
                                    </div>

                                    <div class="bg-1 rounded-5 p-3">
                                        <i class="bi bi-person fs-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 md:col-6 xl:col-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-7">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fg-secondary small mb-3">
                                            Authentication
                                        </div>
                                        <div class="fw-semibold">
                                            @(identity?.AuthenticationType ?? "Unknown")
                                        </div>
                                    </div>

                                    <div class="bg-1 rounded-5 p-3">
                                        <i class="bi bi-shield-lock fs-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 md:col-6 xl:col-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-7">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fg-secondary small mb-3">
                                            Claims
                                        </div>
                                        <div class="fw-semibold">
                                            @claims.Count
                                        </div>
                                    </div>

                                    <div class="bg-1 rounded-5 p-3">
                                        <i class="bi bi-list-check fs-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 md:col-6 xl:col-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-7">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fg-secondary small mb-3">
                                            Session
                                        </div>
                                        <div class="fw-semibold fg-success">
                                            Active
                                        </div>
                                    </div>

                                    <div class="bg-1 rounded-5 p-3">
                                        <i class="bi bi-clock-history fs-lg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row g-7">

                    <!-- Session -->
                    <div class="col-12 lg:col-5">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-header bg-body border-0 px-7 pt-7">
                                <div class="d-flex align-items-center">
                                    <div class="bg-inverse fg-contrast-inverse rounded-5 p-3 me-5">
                                        <i class="bi bi-clock"></i>
                                    </div>

                                    <div>
                                        <h2 class="h5 mb-1">
                                            Session
                                        </h2>
                                        <p class="fg-secondary small mb-0">
                                            Authentication lifetime
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body px-7 pb-7">

                                <div class="py-5 border-bottom">
                                    <div class="fg-secondary small mb-1">
                                        Issued
                                    </div>

                                    <div class="fw-medium text-break">
                                        @issued
                                    </div>
                                </div>

                                <div class="py-5">
                                    <div class="fg-secondary small mb-1">
                                        Expires
                                    </div>

                                    <div class="fw-medium text-break">
                                        @expires
                                    </div>
                                </div>

                                <div class="alert theme-secondary border mt-3 mb-0">
                                    <div class="d-flex">
                                        <i class="bi bi-info-circle me-3 mt-1"></i>
                                        <div class="small">
                                            This session is managed by the application's
                                            authentication middleware.
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Identity -->
                    <div class="col-12 lg:col-7">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-header bg-body border-0 px-7 pt-7">
                                <div class="d-flex align-items-center">
                                    <div class="bg-inverse fg-contrast-inverse rounded-5 p-3 me-5">
                                        <i class="bi bi-person-badge"></i>
                                    </div>

                                    <div>
                                        <h2 class="h5 mb-1">
                                            Identity
                                        </h2>
                                        <p class="fg-secondary small mb-0">
                                            Current authenticated identity
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body px-7 pb-7">

                                <div class="row g-5">

                                    <div class="sm:col-6">
                                        <div class="border rounded-5 p-5 h-100">
                                            <div class="fg-secondary small mb-1">
                                                Name
                                            </div>

                                            <div class="fw-semibold text-break">
                                                @displayName
                                            </div>
                                        </div>
                                    </div>

                                    <div class="sm:col-6">
                                        <div class="border rounded-5 p-5 h-100">
                                            <div class="fg-secondary small mb-1">
                                                Authentication Type
                                            </div>

                                            <div class="fw-semibold text-break">
                                                @(identity?.AuthenticationType ?? "Unknown")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="sm:col-6">
                                        <div class="border rounded-5 p-5 h-100">
                                            <div class="fg-secondary small mb-1">
                                                Is Authenticated
                                            </div>

                                            <div class="fw-semibold fg-success">
                                                Yes
                                            </div>
                                        </div>
                                    </div>

                                    <div class="sm:col-6">
                                        <div class="border rounded-5 p-5 h-100">
                                            <div class="fg-secondary small mb-1">
                                                Claims
                                            </div>

                                            <div class="fw-semibold">
                                                @claims.Count
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Claims -->
                    <div class="col-12">

                        <div class="card border-0 shadow-sm">

                            <div class="card-header bg-body border-0 px-7 pt-7">
                                <div class="d-flex flex-column md:flex-row justify-content-between md:align-items-center gap-3">

                                    <div class="d-flex align-items-center">
                                        <div class="bg-inverse fg-contrast-inverse rounded-5 p-3 me-5">
                                            <i class="bi bi-key"></i>
                                        </div>

                                        <div>
                                            <h2 class="h5 mb-1">
                                                Claims
                                            </h2>

                                            <p class="fg-secondary small mb-0">
                                                Claims received from the identity provider.
                                            </p>
                                        </div>
                                    </div>

                                    <span class="badge badge-subtle rounded-pill theme-secondary px-5 py-3">
                                        @claims.Count total
                                    </span>

                                </div>
                            </div>

                            <div class="card-body p-7">

                                @if (claims.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">

                                            <thead class="">
                                                <tr>
                                                    <th style="width:35%;">
                                                        Type
                                                    </th>
                                                    <th>
                                                        Value
                                                    </th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var claim in claims)
                                                {
                                                    <tr>
                                                        <td>
                                                            <code class="small">
                                                                @claim.Type
                                                            </code>
                                                        </td>

                                                        <td class="text-break">
                                                            @claim.Value
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-12 fg-secondary">
                                        <i class="bi bi-inbox fs-4xl d-block mb-5"></i>
                                        <div class="fw-medium">
                                            No claims available
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </section>
    }
    else
    {
        <!-- Signed out -->
        <section class="flex-grow-1 d-flex align-items-center justify-content-center bg-1 px-5">

            <div class="card border-0 shadow-sm text-center"
                 style="max-width:460px;width:100%;">

                <div class="card-body p-12">

                    <div class="bg-inverse fg-contrast-inverse rounded-circle d-inline-flex align-items-center justify-content-center mb-7"
                         style="width:76px;height:76px;">
                        <i class="bi bi-person-lock fs-3xl"></i>
                    </div>

                    <h1 class="h3 fw-semibold mb-3">
                        Sign in to continue
                    </h1>

                    <p class="fg-secondary mb-7">
                        You are currently signed out.
                        Sign in to access your account.
                    </p>

                    <a class="btn btn-solid theme-inverse px-7 py-3"
                       asp-controller="Account"
                       asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-3"></i>
                        Sign in
                    </a>

                </div>

            </div>

        </section>
    }

    <!-- Footer -->
    <footer class="bg-body border-top py-5">
        <div class="container-fluid px-7 lg:px-12">
            <div class="d-flex flex-column md:flex-row justify-content-between align-items-center gap-3">

                <span class="fg-secondary small">
                    © @DateTime.Now.Year BlogArray
                </span>

                <a href="https://blogarray.net/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-decoration-none fg-secondary small">
                    Crafted by Team BlogArray
                </a>

            </div>
        </div>
    </footer>

</main>